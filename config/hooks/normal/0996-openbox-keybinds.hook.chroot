#!/bin/sh
# GENERATED by scripts/cbpp-apply from cbpp.conf - do not edit by hand.
#
# Add the conventional Openbox keybindings CBPP does not ship. Everything here
# uses a key that rc.xml leaves free, so nothing existing is rebound - except
# Print, handled separately at the bottom.
set -e

RC=/etc/skel/.config/openbox/rc.xml

if [ ! -f "$RC" ]; then
	echo "I: $RC not present, skipping keybindings"
	exit 0
fi

if grep -q "cbpp classic keybindings" "$RC"; then
	echo "I: keybindings already present"
	exit 0
fi

grep -q "<keyboard>" "$RC" ||
	{ echo "E: no <keyboard> section in $RC" >&2; exit 1; }

# CBPP ships two desktops; W-F1..W-F4 already switch between them, but the
# number-row equivalents are what most people reach for.
awk '
	/<keyboard>/ && !done {
		print
		print "    <!-- cbpp classic keybindings -->"
		print "    <keybind key=\"W-q\">"
		print "      <action name=\"Close\"/>"
		print "    </keybind>"
		print "    <keybind key=\"W-Return\">"
		print "      <action name=\"Execute\">"
		print "        <command>x-terminal-emulator</command>"
		print "      </action>"
		print "    </keybind>"
		print "    <keybind key=\"W-1\">"
		print "      <action name=\"GoToDesktop\"><to>1</to></action>"
		print "    </keybind>"
		print "    <keybind key=\"W-2\">"
		print "      <action name=\"GoToDesktop\"><to>2</to></action>"
		print "    </keybind>"
		print "    <keybind key=\"W-S-1\">"
		print "      <action name=\"SendToDesktop\"><to>1</to></action>"
		print "    </keybind>"
		print "    <keybind key=\"W-S-2\">"
		print "      <action name=\"SendToDesktop\"><to>2</to></action>"
		print "    </keybind>"
		print "    <keybind key=\"W-S-q\">"
		print "      <action name=\"Execute\">"
		print "        <command>cbpp-exit</command>"
		print "      </action>"
		print "    </keybind>"
		done = 1
		next
	}
	{ print }
' "$RC" >"$RC.new"

mv "$RC.new" "$RC"

# Print opens the xfce4-screenshooter dialog by default. Everywhere else Print
# just takes the shot, so point it at cbpp-screenshot; the dialog is still one
# click away under Graphics > Take Screenshot > Screenshooter.
if [ -x /usr/bin/cbpp-screenshot ] && grep -q "xfce4-screenshooter" "$RC"; then
	sed -i 's|<command>xfce4-screenshooter</command>|<command>cbpp-screenshot</command>|' "$RC"
	echo "I: Print now takes a full-screen shot directly"
fi

if command -v xmllint >/dev/null 2>&1; then
	xmllint --noout "$RC" ||
		{ echo "E: rc.xml is not well-formed after editing" >&2; exit 1; }
fi

echo "I: added the classic keybindings to the Openbox config"
