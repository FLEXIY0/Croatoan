#!/bin/sh
# GENERATED by scripts/cbpp-apply from cbpp.conf - do not edit by hand.
#
# Point the desktop at the browser and notifier this image actually ships, and
# make sure every launcher in the panel refers to something that exists.
set -e

BROWSER="falkon"
NOTIFY="dunst"

# --- default browser -------------------------------------------------------
#
# helpers.rc and the Openbox menu both go through x-www-browser, so setting the
# alternative is most of the job. falkon does not register itself for it.
if [ -n "$BROWSER" ]; then
	command -v "$BROWSER" >/dev/null 2>&1 ||
		{ echo "E: $BROWSER is not installed" >&2; exit 1; }

	update-alternatives --install /usr/bin/x-www-browser \
		x-www-browser "/usr/bin/$BROWSER" 200
	update-alternatives --set x-www-browser "/usr/bin/$BROWSER"

	# gnome-www-browser is what some .desktop files and scripts use instead.
	if update-alternatives --list gnome-www-browser >/dev/null 2>&1; then
		update-alternatives --install /usr/bin/gnome-www-browser \
			gnome-www-browser "/usr/bin/$BROWSER" 200
		update-alternatives --set gnome-www-browser "/usr/bin/$BROWSER"
	fi

	echo "I: default browser is $BROWSER"
fi

# --- notifications ---------------------------------------------------------
if [ "$NOTIFY" = "dunst" ]; then
	if dpkg -l xfce4-notifyd 2>/dev/null | grep -q "^ii"; then
		DEBIAN_FRONTEND=noninteractive apt-get -y purge xfce4-notifyd
		echo "I: purged xfce4-notifyd"
	fi

	# cbpp-configs starts xfce4-notifyd by hand at the end of the autostart,
	# because it stopped being D-Bus activated. dunst is activated properly, so
	# the line just has to go.
	for AS in /etc/skel/.config/openbox/autostart /root/.config/openbox/autostart
	do
		[ -f "$AS" ] || continue
		sed -i 's|^/usr/lib/\*/xfce4/notifyd/xfce4-notifyd|#&|' "$AS"
	done
fi

# --- panel launchers -------------------------------------------------------
#
# tint2 draws nothing at all for a launcher whose .desktop is missing, so a
# stale name leaves a silent gap. Three of the four shipped ones pointed
# nowhere: iceweasel has not existed in Debian since 2016, gedit is not in this
# image, and xfce4-file-manager.desktop is not what Thunar installs.
#
# So the list is kept as program names and each is resolved against what is
# actually on disk - including the reverse-DNS form KDE now uses, which is why
# Falkon ships org.kde.falkon.desktop and not falkon.desktop. Guessing that
# name would have left the browser missing from the panel.
LAUNCHERS="sakura thunar geany falkon"

find_desktop() {
	for _cand in "/usr/share/applications/$1.desktop" \
		"/usr/share/applications/"*".$1.desktop"
	do
		if [ -e "$_cand" ]; then
			printf '%s' "$_cand"
			return 0
		fi
	done
	return 1
}

RESOLVED=""
for APP in $LAUNCHERS; do
	if D=$(find_desktop "$APP"); then
		RESOLVED="$RESOLVED$D
"
	else
		echo "W: no .desktop file for '$APP', leaving it out of the panel" >&2
	fi
done

[ -n "$RESOLVED" ] ||
	{ echo "E: not one panel launcher could be resolved" >&2; exit 1; }

for TINT in /etc/skel/.config/tint2/tint2rc /root/.config/tint2/tint2rc
do
	[ -f "$TINT" ] || continue

	# Replace the whole block in place, so this is the same whether it runs
	# once or twice and whatever state the file was left in.
	printf '%s' "$RESOLVED" >/tmp/cbpp-launchers
	awk '
		/^launcher_item_app = / {
			if (!done) {
				while ((getline line < "/tmp/cbpp-launchers") > 0)
					print "launcher_item_app = " line
				done = 1
			}
			next
		}
		{ print }
	' "$TINT" >"$TINT.new"
	mv "$TINT.new" "$TINT"
	rm -f /tmp/cbpp-launchers

	echo "I: $TINT: $(grep -c '^launcher_item_app = ' "$TINT") launchers"
	grep '^launcher_item_app = ' "$TINT" | sed 's|^|I:   |'
done
