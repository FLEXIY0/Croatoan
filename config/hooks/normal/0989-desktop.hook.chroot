#!/bin/sh
# GENERATED by scripts/cbpp-apply from cbpp.conf - do not edit by hand.
#
# Point the desktop at the browser and notifier this image actually ships, and
# make sure every launcher in the panel refers to something that exists.
set -e

BROWSER="falkon"
NOTIFY="dunst"

# --- default browser -------------------------------------------------------
#
# helpers.rc and the Openbox menu both go through x-www-browser, so setting the
# alternative is most of the job. falkon does not register itself for it.
if [ -n "$BROWSER" ]; then
	command -v "$BROWSER" >/dev/null 2>&1 ||
		{ echo "E: $BROWSER is not installed" >&2; exit 1; }

	update-alternatives --install /usr/bin/x-www-browser \
		x-www-browser "/usr/bin/$BROWSER" 200
	update-alternatives --set x-www-browser "/usr/bin/$BROWSER"

	# gnome-www-browser is what some .desktop files and scripts use instead.
	if update-alternatives --list gnome-www-browser >/dev/null 2>&1; then
		update-alternatives --install /usr/bin/gnome-www-browser \
			gnome-www-browser "/usr/bin/$BROWSER" 200
		update-alternatives --set gnome-www-browser "/usr/bin/$BROWSER"
	fi

	echo "I: default browser is $BROWSER"
fi

# --- notifications ---------------------------------------------------------
if [ "$NOTIFY" = "dunst" ]; then
	if dpkg -l xfce4-notifyd 2>/dev/null | grep -q "^ii"; then
		DEBIAN_FRONTEND=noninteractive apt-get -y purge xfce4-notifyd
		echo "I: purged xfce4-notifyd"
	fi

	# cbpp-configs starts xfce4-notifyd by hand at the end of the autostart,
	# because it stopped being D-Bus activated. dunst is activated properly, so
	# the line just has to go.
	for AS in /etc/skel/.config/openbox/autostart /root/.config/openbox/autostart
	do
		[ -f "$AS" ] || continue
		sed -i 's|^/usr/lib/\*/xfce4/notifyd/xfce4-notifyd|#&|' "$AS"
	done
fi

# --- panel launchers -------------------------------------------------------
#
# tint2 silently draws nothing for a launcher whose .desktop is missing, so a
# stale name is invisible until you notice the gap. iceweasel has not existed
# in Debian since 2016 and gedit is not in this image at all, so two of the
# four shipped launchers were already dead.
for TINT in /etc/skel/.config/tint2/tint2rc /root/.config/tint2/tint2rc
do
	[ -f "$TINT" ] || continue

	if [ -n "$BROWSER" ]; then
		sed -i "s|applications/iceweasel.desktop|applications/$BROWSER.desktop|" "$TINT"
	fi

	MISSING=0
	while read -r LINE; do
		DESKTOP=${LINE#launcher_item_app = }
		[ -e "$DESKTOP" ] && continue

		echo "W: panel launcher $DESKTOP does not exist, dropping it" >&2
		sed -i "\\|^launcher_item_app = $DESKTOP$|d" "$TINT"
		MISSING=$((MISSING + 1))
	done <<LAUNCHERS
$(grep "^launcher_item_app = " "$TINT" || true)
LAUNCHERS

	echo "I: $TINT: $(grep -c "^launcher_item_app = " "$TINT") launchers, $MISSING dropped"
done
