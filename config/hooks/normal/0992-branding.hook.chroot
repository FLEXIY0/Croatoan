#!/bin/sh
# GENERATED by scripts/cbpp-apply from cbpp.conf - do not edit by hand.
#
# Rename #!++ to Croatoan everywhere this image can reach it.
#
# Most of the old name is inside other people's packages, so this runs after
# they are installed and rewrites what they wrote. What it cannot reach:
# strings compiled into debian-installer's own udebs, and the artwork in
# cbpp-wallpapers.
set -e

# --- what the system calls itself ------------------------------------------
#
# ID stays "debian" on purpose: scripts and third-party installers branch on
# it, and lying there breaks them for no gain.
OSR=/usr/lib/os-release
[ -f "$OSR" ] || OSR=/etc/os-release

if [ -f "$OSR" ]; then
	sed -i \
		-e 's|^NAME=.*|NAME="Croatoan"|' \
		-e 's|^PRETTY_NAME=.*|PRETTY_NAME="Croatoan 13.1"|' \
		"$OSR"
	echo "I: $OSR now says Croatoan"
fi

# Written whole rather than sed'ed: the escapes getty expands here (\n for the
# hostname, \l for the line) would be eaten by sed's own replacement syntax.
cat >/etc/issue <<'ISSUE'
Croatoan 13.1 \n \l

ISSUE

printf '%s\n' "Croatoan 13.1" >/etc/issue.net

# --- the welcome script ----------------------------------------------------
if [ -d /usr/lib/lib-cbpp-welcome ]; then
	grep -rl "CrunchBangPlusPlus" /usr/lib/lib-cbpp-welcome 2>/dev/null |
		while read -r F; do
			sed -i 's|CrunchBangPlusPlus|Croatoan|g' "$F"
		done
	echo "I: rebranded the welcome script"
fi

# --- the root menu ---------------------------------------------------------
for RC in /etc/skel/.config/openbox/menu.xml /root/.config/openbox/menu.xml
do
	[ -f "$RC" ] || continue
	sed -i 's|<menu id="root-menu" label="[^"]*">|<menu id="root-menu" label="Croatoan">|' "$RC"

	if command -v xmllint >/dev/null 2>&1; then
		xmllint --noout "$RC" ||
			{ echo "E: $RC is not well-formed after editing" >&2; exit 1; }
	fi
done
