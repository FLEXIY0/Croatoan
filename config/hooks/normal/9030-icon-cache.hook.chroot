#!/bin/sh
# GENERATED by scripts/cbpp-apply from cbpp.conf - do not edit by hand.
#
# Build the icon and font caches, so applications do not each rebuild them.
set -e

if ! command -v gtk-update-icon-cache >/dev/null 2>&1; then
	echo "E: gtk-update-icon-cache is missing (libgtk-3-bin)" >&2
	exit 1
fi

BUILT=0
for THEME in /usr/share/icons/*/; do
	[ -f "${THEME}index.theme" ] || continue

	# --ignore-theme-index would build a cache for directories that are not
	# themes; -f rebuilds rather than trusting an out-of-date one.
	if gtk-update-icon-cache -f -q "$THEME" 2>/dev/null; then
		BUILT=$((BUILT + 1))
	fi
done

echo "I: built $BUILT icon caches"

# The system font cache. Without it the first GTK or Qt program each user runs
# builds a private one in ~/.cache, which is the slowest possible first launch.
if command -v fc-cache >/dev/null 2>&1; then
	fc-cache -f >/dev/null 2>&1 || true
	echo "I: built the font cache"
fi
