#!/bin/sh
# GENERATED by scripts/cbpp-apply from cbpp.conf - do not edit by hand.
#
# The openbox autostart launches parcellite, which trixie no longer carries.
# Point it at the replacement so the line actually starts something.
set -e

AUTOSTART=/etc/skel/.config/openbox/autostart

if [ ! -f "$AUTOSTART" ]; then
	echo "I: $AUTOSTART not present, skipping the clipboard manager"
	exit 0
fi

if grep -q "xfce4-clipman" "$AUTOSTART"; then
	echo "I: clipboard manager already set"
	exit 0
fi

grep -q "parcellite" "$AUTOSTART" ||
	{ echo "E: no parcellite line in $AUTOSTART to replace" >&2; exit 1; }

sed -i 's/parcellite/xfce4-clipman/g' "$AUTOSTART"
echo "I: clipboard manager is now xfce4-clipman"
