#!/bin/sh
# GENERATED by scripts/cbpp-apply from cbpp.conf - do not edit by hand.
#
# The shipped panel lists shortcuts that no longer describe the system: it
# predates the keybindings we add, so Super+q, Super+Return, the desktop
# numbers and Super+Shift+q are all missing from it. Rewrite the block to match
# what rc.xml actually binds, and add a zram line while we are here.
set -e

RC=/etc/skel/.conkyrc

if [ ! -f "$RC" ]; then
	echo "I: $RC not present, skipping the conky panel"
	exit 0
fi

if grep -q "cbpp-zram-status" "$RC"; then
	echo "I: conky panel already updated"
	exit 0
fi

grep -q "S H O R T C U T" "$RC" ||
	{ echo "E: no shortcut block in $RC to replace" >&2; exit 1; }
grep -q "Swap usage:" "$RC" ||
	{ echo "E: no swap line in $RC to anchor the zram line to" >&2; exit 1; }

awk '
	/^Swap usage:/ {
		print
		print "zram:$alignr${execi 10 cbpp-zram-status}"
		next
	}
	/^S H O R T C U T/ { shortcuts = 1 }
	shortcuts && /^\]\];/ {
		print "S H O R T C U T    K E Y S"
		print "${hr}"
		print "Super+Return$alignr Terminal"
		print "Super+q$alignr Close Window"
		print "Super+Space$alignr Main Menu"
		print "Super+Tab$alignr Client Menu"
		print "Alt+F2$alignr Run Dialog"
		print "Alt+F3$alignr Alt Menu"
		print "Super+1 / +2$alignr Switch Desktop"
		print "Super+Shift+1 / +2$alignr Move Window"
		print "Super+f$alignr File Manager"
		print "Super+e$alignr Editor"
		print "Super+w$alignr Web Browser"
		print "Super+m$alignr Media Player"
		print "Super+h$alignr Task Manager"
		print "Super+v$alignr Volume Control"
		print "Super+l$alignr Lock Screen"
		print "Super+x$alignr Logout"
		print "PrtSc$alignr Screenshot"
		print ""
		shortcuts = 0
	}
	!shortcuts { print }
' "$RC" >"$RC.new"

mv "$RC.new" "$RC"
echo "I: conky panel now lists the real shortcuts and reports zram"
