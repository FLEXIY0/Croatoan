#!/bin/sh
# GENERATED by scripts/cbpp-apply from cbpp.conf - do not edit by hand.
#
# Fail the build loudly if the backports kernel pin did not take.
set -e

VERSION="$(dpkg-query -W -f='${Version}' "linux-image-amd64")"

case "$VERSION" in
*bpo*)
	echo "I: kernel from trixie-backports: $VERSION"
	;;
*)
	echo "E: CBPP_KERNEL_BACKPORTS is enabled but linux-image-amd64 is $VERSION," >&2
	echo "E: which did not come from trixie-backports. Check LB_BACKPORTS and" >&2
	echo "E: config/archives/cbpp-backports.pref.chroot." >&2
	exit 1
	;;
esac
