#!/bin/sh
# GENERATED by scripts/cbpp-apply from cbpp.conf - do not edit by hand.
#
# Put emptty on tty7 and take lxdm out.
#
# lxdm starts a second X server, draws a login box in GTK2, and throws the
# whole thing away the moment you log in. emptty is one Go binary on a virtual
# console, linked against libc, libpam and libx11, that starts your X server
# directly.
set -e

command -v emptty >/dev/null 2>&1 ||
	{ echo "E: emptty is not installed" >&2; exit 1; }

mkdir -p /etc/emptty

cat >/etc/emptty/conf-tty7 <<'CONF'
# GENERATED by scripts/cbpp-apply from cbpp.conf - do not edit by hand.
#
# TTY_NUMBER is deliberately absent: the systemd unit passes it on the command
# line, and this file is named after it.
SWITCH_TTY=true
PRINT_ISSUE=false
PRINT_MOTD=true
MOTD_PATH=/etc/emptty/motd
DEFAULT_SESSION=Openbox
DEFAULT_SESSION_ENV=xorg
AUTO_SELECTION=true
SELECT_LAST_USER=global
FG_COLOR=WHITE
BG_COLOR=BLACK
DBUS_LAUNCH=true
LOGGING=rotate
CONF

# The shipped motd is a symlink to a Debian-branded banner under /usr/share.
rm -f /etc/emptty/motd
cp /usr/share/cbpp/emptty-motd /etc/emptty/motd

# The symlink is written directly rather than through "systemctl enable":
# systemd refuses some operations inside a chroot, and this is exactly what
# enabling a WantedBy=multi-user.target template amounts to. cbpp-apt-setup in
# this tree is wired up the same way.
UNIT=/usr/lib/systemd/system/emptty@.service
[ -f "$UNIT" ] || { echo "E: $UNIT is missing" >&2; exit 1; }

mkdir -p /etc/systemd/system/multi-user.target.wants
ln -sf "$UNIT" /etc/systemd/system/multi-user.target.wants/emptty@tty7.service

# lxdm came from the package list and cbpp-lxdm-theme from cbpp-metapackage's
# Recommends. Neither has anything left to do, and a second display manager
# competing for a console is worse than dead weight.
PURGE=""
for P in lxdm cbpp-lxdm-theme; do
	if dpkg -l "$P" 2>/dev/null | grep -q "^ii"; then
		PURGE="$PURGE $P"
	fi
done

if [ -n "$PURGE" ]; then
	systemctl disable lxdm.service >/dev/null 2>&1 || true
	DEBIAN_FRONTEND=noninteractive apt-get -y purge $PURGE
	DEBIAN_FRONTEND=noninteractive apt-get -y autoremove --purge
	echo "I: purged$PURGE"
fi

# lxdm's postinst points this at itself; nothing should now.
rm -f /etc/systemd/system/display-manager.service

echo "I: emptty is the display manager on tty7"
