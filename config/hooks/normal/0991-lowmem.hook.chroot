#!/bin/sh
# GENERATED by scripts/cbpp-apply from cbpp.conf - do not edit by hand.
#
# The low-memory profile: what comes out on a machine with 2 GB and a 2009 GPU.
set -e

TRIM_INDEXERS="true"
TRIM_DAEMONS="true"
COMPOSITOR="false"
THUNAR_DAEMON="false"
SCREENSAVER="i3lock"

purge() {
	_list=""
	for _p in "$@"; do
		if dpkg -l "$_p" 2>/dev/null | grep -q "^ii"; then
			_list="$_list $_p"
		fi
	done

	[ -n "$_list" ] || return 0
	DEBIAN_FRONTEND=noninteractive apt-get -y purge $_list
	echo "I: purged$_list"
}

# --- background indexers ---------------------------------------------------
#
# update-apt-xapian-index peaks over 300 MB and runs weekly; on 2 GB that is a
# swap storm, and nothing but synaptic's quick search reads what it builds.
# plocate walks the whole filesystem daily. live-build's own 5010 and 5030
# hooks build these indices later in the build, but both test for the command
# first, so removing the packages here just makes them no-ops.
if [ "$TRIM_INDEXERS" = "true" ]; then
	purge apt-xapian-index plocate mlocate

	# man pages stay; only the index rebuild goes.
	rm -f /etc/cron.daily/man-db
	if [ -e /usr/lib/systemd/system/man-db.timer ]; then
		ln -sf /dev/null /etc/systemd/system/man-db.timer
		echo "I: masked man-db.timer"
	fi
fi

# --- daemons with nothing to do on this hardware ---------------------------
#
# Each of these is resident and each has a specific reason to be absent here,
# rather than being cut for the sake of cutting:
#
#   ModemManager           probes for a WWAN modem this laptop does not have
#   power-profiles-daemon  needs a platform profile driver; Core 2 has none
#   at-spi                 the accessibility bus, started by every GTK app,
#                          and used by nothing unless a screen reader runs
#   apt-daily timers       refresh package lists twice a day, which on 2 GB is
#                          a 100 MB spike and disk thrash at an arbitrary
#                          moment - exactly what "it froze for no reason"
#                          looks like. apt by hand is unaffected.
#
# avahi and the video thumbnailers are deliberately left alone: both do
# something visible.
if [ "$TRIM_DAEMONS" = "true" ]; then
	purge modemmanager power-profiles-daemon

	for T in apt-daily.timer apt-daily-upgrade.timer; do
		[ -e "/usr/lib/systemd/system/$T" ] || continue
		ln -sf /dev/null "/etc/systemd/system/$T"
		echo "I: masked $T"
	done

	# at-spi stays installed - GTK copes either way, and putting it back is
	# one line - but nothing starts it.
	mkdir -p /etc/X11/Xsession.d
	cat >/etc/X11/Xsession.d/60cbpp-no-at-bridge <<'ATSPI'
# Keep GTK from starting the accessibility bus. Delete this file, or set
# NO_AT_BRIDGE=0, if you need a screen reader.
NO_AT_BRIDGE=1
export NO_AT_BRIDGE
ATSPI
	echo "I: the accessibility bus will not be started"
fi

# --- the screen locker -----------------------------------------------------
#
# xscreensaver is resident for the whole session. i3lock only exists while the
# screen is locked, and X blanks the screen by itself, so the Lock Screen
# entries move over and the Screensaver settings entry goes - it would
# configure a program that is no longer there.
if [ "$SCREENSAVER" != "xscreensaver" ]; then
	purge xscreensaver xscreensaver-data

	for F in /etc/skel/.config/openbox/rc.xml /etc/skel/.config/openbox/menu.xml \
		/root/.config/openbox/rc.xml /root/.config/openbox/menu.xml
	do
		[ -f "$F" ] || continue

		if [ "$SCREENSAVER" = "i3lock" ]; then
			sed -i 's|xscreensaver-command -lock|i3lock -c 000000|g' "$F"
		fi

		# Drop the "Screensaver" item, which is five lines around
		# xscreensaver-demo.
		awk '
			/<item label="Screensaver">/ { skip = 1 }
			!skip { print }
			skip && /<\/item>/ { skip = 0 }
		' "$F" >"$F.new"
		mv "$F.new" "$F"

		if command -v xmllint >/dev/null 2>&1; then
			xmllint --noout "$F" ||
				{ echo "E: $F is not well-formed after editing" >&2; exit 1; }
		fi
	done

	rm -f /etc/skel/.xscreensaver
	echo "I: screen locking is now $SCREENSAVER"
fi

# --- the autostart ---------------------------------------------------------
for AS in /etc/skel/.config/openbox/autostart /root/.config/openbox/autostart
do
	[ -f "$AS" ] || continue

	if [ "$COMPOSITOR" = "false" ]; then
		sed -i 's|^cbpp-compositor --start|#cbpp-compositor --start|' "$AS"
	fi

	if [ "$THUNAR_DAEMON" = "false" ]; then
		sed -i 's|^thunar --daemon|#thunar --daemon|' "$AS"
	fi

	if [ "$SCREENSAVER" != "xscreensaver" ]; then
		sed -i 's|^xscreensaver -no-splash|#xscreensaver -no-splash|' "$AS"

		# X blanks the screen on its own; DPMS powers the backlight down
		# afterwards. Neither costs a resident process.
		if ! grep -q "cbpp: screen blanking" "$AS"; then
			cat >>"$AS" <<'BLANK'

## Screen blanking without a daemon (cbpp: screen blanking)
xset s 600 &
xset dpms 0 0 900 &
BLANK
		fi
	fi

	echo "I: trimmed $AS"
done
