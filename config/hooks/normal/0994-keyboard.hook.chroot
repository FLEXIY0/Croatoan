#!/bin/sh
# GENERATED by scripts/cbpp-apply from cbpp.conf - do not edit by hand.
#
# Take out ibus and put the layout indicator in the panel instead.
set -e

# --- ibus ------------------------------------------------------------------
#
# ibus arrives as a Recommends of cbpp-metapackage and is launched by
# im-config's Xsession script. It is a whole input-method framework - GTK3,
# dconf, python3 and a resident daemon - whose only visible contribution here
# is naming the layout, and it cannot even switch, because only "us" was ever
# configured. Nothing in cbpp-metapackage depends on it, so it can go.
PURGE=""
for P in ibus im-config; do
	if dpkg -l "$P" 2>/dev/null | grep -q "^ii"; then
		PURGE="$PURGE $P"
	fi
done

if [ -n "$PURGE" ]; then
	DEBIAN_FRONTEND=noninteractive apt-get -y purge $PURGE
	DEBIAN_FRONTEND=noninteractive apt-get -y autoremove --purge
	echo "I: purged$PURGE"
fi

# --- the console -----------------------------------------------------------
if [ -f /etc/default/keyboard ]; then
	sed -i 's|^XKBLAYOUT=.*|XKBLAYOUT="us,ru"|' /etc/default/keyboard
	sed -i 's|^XKBOPTIONS=.*|XKBOPTIONS="grp:alt_shift_toggle"|' /etc/default/keyboard
fi

# --- the indicator ---------------------------------------------------------
INDICATOR="true"
TINT2=/etc/skel/.config/tint2/tint2rc

if [ "$INDICATOR" != "true" ]; then
	echo "I: no layout indicator was asked for"
	exit 0
fi

if [ ! -f "$TINT2" ]; then
	echo "W: $TINT2 is not there, skipping the layout indicator" >&2
	exit 0
fi

if grep -q "cbpp-kblayout" "$TINT2"; then
	echo "I: the layout indicator is already in the panel"
	exit 0
fi

# tint2 pairs the Nth E in panel_items with the Nth execp block, so the block
# can simply go at the end of the file. E before C puts it left of the clock.
grep -q "^panel_items = TSC$" "$TINT2" ||
	{ echo "E: unexpected panel_items in $TINT2" >&2; exit 1; }

sed -i 's|^panel_items = TSC$|panel_items = TSEC|' "$TINT2"

cat >>"$TINT2" <<'PANEL'

# Keyboard layout
execp = new
execp_command = cbpp-kblayout
execp_interval = 1
execp_has_icon = 0
execp_continuous = 0
execp_markup = 0
execp_font = Liberation Sans Bold 10
execp_font_color = #cc0000 100
execp_padding = 8 4
execp_background_id = 0
execp_centered = 1
execp_tooltip = Keyboard layout
execp_lclick_command = xdotool key --clearmodifiers alt+shift
PANEL

echo "I: added the layout indicator to the panel"
