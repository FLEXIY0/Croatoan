#!/bin/sh
# GENERATED by scripts/cbpp-apply from cbpp.conf - do not edit by hand.
#
# Add a one-click "Screenshot" entry to the Openbox root menu. CBPP already has
# one under Graphics > Take Screenshot > Now, but that is three levels deep and
# opens an image viewer afterwards.
set -e

MENU=/etc/skel/.config/openbox/menu.xml

if [ ! -f "$MENU" ]; then
	echo "I: $MENU not present, skipping the screenshot menu entry"
	exit 0
fi

if grep -q "cbpp-screenshot" "$MENU"; then
	echo "I: screenshot entry already present"
	exit 0
fi

# Anchor on the Media Player launcher, the last item in the root menu's
# top group. Fail rather than silently drop the feature if it moves.
grep -q "<execute>vlc</execute>" "$MENU" ||
	{ echo "E: cannot find the root-menu anchor in $MENU" >&2; exit 1; }

awk '
	/<execute>vlc<\/execute>/ { seen = 1 }
	{ print }
	seen && /<\/item>/ && !done {
		print "    <item label=\"Screenshot\">"
		print "      <action name=\"Execute\">"
		print "        <execute>cbpp-screenshot</execute>"
		print "      </action>"
		print "    </item>"
		done = 1
	}
' "$MENU" >"$MENU.new"

mv "$MENU.new" "$MENU"

# openbox ships a schema for this file; use it if xmllint is around.
if command -v xmllint >/dev/null 2>&1; then
	xmllint --noout "$MENU" ||
		{ echo "E: menu.xml is not well-formed after editing" >&2; exit 1; }
fi

echo "I: added the Screenshot entry to the Openbox root menu"
