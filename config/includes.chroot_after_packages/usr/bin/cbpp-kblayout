#!/bin/sh
# GENERATED by scripts/cbpp-apply from cbpp.conf - do not edit by hand.
#
# Print the active keyboard layout, for the tint2 indicator.
#
# X has no command that simply reports the active XKB group. It is mirrored
# into the keyboard LED mask, which xset does print - groups 2, 3 and 4 light
# bits 12, 13 and 14 - and that is what every shell indicator ends up reading.
#
# The layout list is baked in rather than read back from setxkbmap so that this
# costs one process per tick instead of two; it comes from the same
# CBPP_KEYBOARD_LAYOUTS that wrote the Xorg snippet.
set -eu

LAYOUTS="us,ru"

MASK=$(xset -q 2>/dev/null | awk '/LED mask/ { print $NF }')
case "$MASK" in
"" | *[!0-9A-Fa-f]*) MASK=0 ;;
esac

BITS=$((0x$MASK))

if [ $((BITS & 0x4000)) -ne 0 ]; then
	INDEX=4
elif [ $((BITS & 0x2000)) -ne 0 ]; then
	INDEX=3
elif [ $((BITS & 0x1000)) -ne 0 ]; then
	INDEX=2
else
	INDEX=1
fi

NAME=$(printf '%s' "$LAYOUTS" | cut -d, -f"$INDEX")
[ -n "$NAME" ] || NAME=$(printf '%s' "$LAYOUTS" | cut -d, -f1)

printf '%s\n' "$NAME" | tr 'a-z' 'A-Z'
