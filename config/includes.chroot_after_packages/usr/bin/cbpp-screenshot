#!/bin/sh
# GENERATED by scripts/cbpp-apply from cbpp.conf - do not edit by hand.
#
# Grab the whole screen, save it, and say where it went. No dialog, no viewer
# popping up over the thing you just captured.
set -eu

if ! command -v scrot >/dev/null 2>&1; then
	echo "cbpp-screenshot: scrot is not installed" >&2
	exit 1
fi

# CBPP's own user setup creates ~/images; fall back for anyone who removed it.
for _d in "$HOME/images" "$HOME/Pictures" "$HOME"; do
	if [ -d "$_d" ]; then
		DIR=$_d
		break
	fi
done

FILE="$DIR/screenshot-$(date +%Y-%m-%d-%H%M%S).png"
scrot "$FILE"

if command -v notify-send >/dev/null 2>&1; then
	notify-send -i "$FILE" "Screenshot saved" "$FILE" || true
fi

echo "$FILE"
