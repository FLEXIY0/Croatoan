#!/bin/sh

. /usr/lib/live/config.sh

## GENERATED by scripts/cbpp-apply from cbpp.conf - do not edit by hand.
##
## Autologin for emptty in the live session, modelled on live-config's own
## 0110-lxdm component.

Cmdline ()
{
	for _PARAMETER in ${LIVE_CONFIG_CMDLINE}
	do
		case "${_PARAMETER}" in
			live-config.noautologin|noautologin)
				LIVE_CONFIG_NOAUTOLOGIN="true"
				;;

			live-config.nox11autologin|nox11autologin)
				LIVE_CONFIG_NOX11AUTOLOGIN="true"
				;;

			live-config.username=*|username=*)
				LIVE_USERNAME="${_PARAMETER#*username=}"
				;;
		esac
	done
}

Init ()
{
	case "${LIVE_CONFIG_NOAUTOLOGIN}" in
		true)
			exit 0
			;;
	esac

	case "${LIVE_CONFIG_NOX11AUTOLOGIN}" in
		true)
			exit 0
			;;
	esac

	if ! pkg_is_installed "emptty" || component_was_executed "emptty"
	then
		exit 0
	fi

	echo -n " emptty"
}

Config ()
{
	# emptty will not log anyone in without a password unless they are in
	# nopasswdlogin - the same group gdm3 uses for this.
	if ! getent group nopasswdlogin >/dev/null
	then
		addgroup --system nopasswdlogin >/dev/null 2>&1 || true
	fi

	adduser "${LIVE_USERNAME}" nopasswdlogin >/dev/null 2>&1 || true

	# One config file per console, named after the console.
	for _CONF in /etc/emptty/conf-*
	do
		[ -e "${_CONF}" ] || continue

		sed -i -e "/^AUTOLOGIN=/d" -e "/^DEFAULT_USER=/d" "${_CONF}"
		printf 'AUTOLOGIN=true\nDEFAULT_USER=%s\n' "${LIVE_USERNAME}" \
			>>"${_CONF}"
	done

	# Avoid xinit
	touch /var/lib/live/config/xinit

	# Creating state file
	touch /var/lib/live/config/emptty
}

Cmdline
Init
Config
