# GENERATED by scripts/cbpp-apply from cbpp.conf - do not edit by hand.
#
# Sourced from the end of /etc/skel/.bashrc, which comes from the bash package
# rather than from cbpp-configs - so a hook appends one line to it instead of
# this image shipping a whole copy of Debian's bashrc and owning it forever.
#
# The colour is ANSI 31, not a hex value, because the same prompt has to work
# on the virtual consoles. Terminal-side, slot 1 of the terminator palette is
# CBPP_TERM_ACCENT, so the two agree.

case "$-" in
*i*) ;;
*) return ;;
esac

case "$TERM" in
dumb) return ;;
esac

if [ "$(id -u)" -eq 0 ]; then
	PS1='\[\033[1;31m\]\u@\h\[\033[0m\]:\[\033[1;37m\]\w\[\033[0m\]# '
else
	PS1='\[\033[0;31m\]\u@\h\[\033[0m\]:\[\033[0;37m\]\w\[\033[0m\]$ '
fi

# Debian's bashrc leaves these off, and they are the two that make ls and grep
# legible against a black background.
alias ls='ls --color=auto'
alias grep='grep --color=auto'
