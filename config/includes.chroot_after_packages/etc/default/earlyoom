#
# Act at 5% free memory and 5% free swap rather than earlyoom's default 10%,
# because with zram "free swap" shrinks slowly and 10% fires too eagerly.
# -r 0 silences the periodic memory report, which otherwise fills the journal
# of a live session.
#
# --avoid keeps the session itself alive so the machine stays usable after a
# kill; --prefer names the processes that realistically cause the pressure.
EARLYOOM_ARGS="-r 0 -m 5 -s 5 --avoid '^(systemd|Xorg|openbox|lxdm|tint2|conky)$' --prefer '^(firefox-esr|gimp|vlc|libreoffice)'"
