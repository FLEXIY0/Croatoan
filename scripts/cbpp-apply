#!/bin/sh
# cbpp-apply - stamp cbpp.conf into the live-build tree under config/.
#
# Every value this script writes is owned by cbpp.conf.  Keys it does not know
# about are left exactly as they are, so hand-edits to unrelated live-build
# options survive.  Running it twice in a row is a no-op.
#
# Usage: scripts/cbpp-apply [--quiet] [--check]
#
#   --quiet  only report the summary line
#   --check  report what would change and exit 1 if anything would, without
#            writing.  Used by `make lint` to catch a config/ tree that has
#            drifted away from cbpp.conf.

set -eu

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$ROOT"

QUIET=false
CHECK=false
for _arg in "$@"; do
	case $_arg in
	--quiet) QUIET=true ;;
	--check) CHECK=true ;;
	*) echo "cbpp-apply: unknown option: $_arg" >&2; exit 2 ;;
	esac
done

CHANGED=0

die() { echo "cbpp-apply: $*" >&2; exit 1; }
note() { $QUIET || echo "  $*"; }

[ -f cbpp.conf ] || die "cbpp.conf not found in $ROOT"
# shellcheck disable=SC1091
. ./cbpp.conf

# --------------------------------------------------------------- helpers --

# set_key FILE KEY VALUE - rewrite `KEY="..."` in a live-build config file.
# Fails loudly if the key is absent, so a live-build format change surfaces
# here instead of silently dropping a setting.
set_key() {
	_file=$1
	_key=$2
	_val=$3

	[ -f "$_file" ] || die "$_file: no such file"
	grep -q "^${_key}=" "$_file" || die "$_file: key ${_key} not found"
	case $_val in
	*'"'*) die "${_key}: value must not contain a double quote" ;;
	esac

	awk -v k="$_key" -v v="$_val" '
		index($0, k "=") == 1 { print k "=\"" v "\""; next }
		{ print }
	' "$_file" >"$_file.cbpp-tmp"

	commit_tmp "$_file" "${_key}=\"${_val}\""
}

# commit_tmp FILE DESCRIPTION - promote FILE.cbpp-tmp over FILE unless it is
# byte-identical, honouring --check.
commit_tmp() {
	_f=$1
	_desc=$2

	if [ -f "$_f" ] && cmp -s "$_f" "$_f.cbpp-tmp"; then
		rm -f "$_f.cbpp-tmp"
		return 0
	fi

	CHANGED=$((CHANGED + 1))
	if $CHECK; then
		rm -f "$_f.cbpp-tmp"
		note "would update $_f: $_desc"
	else
		mv "$_f.cbpp-tmp" "$_f"
		note "$_f: $_desc"
	fi
}

# set_field FILE KEY VALUE - same idea for the `Key: value` format of
# config/build.
set_field() {
	_file=$1
	_key=$2
	_val=$3

	[ -f "$_file" ] || die "$_file: no such file"
	grep -q "^${_key}:" "$_file" || die "$_file: field ${_key} not found"

	awk -v k="$_key" -v v="$_val" '
		index($0, k ":") == 1 { print k ": " v; next }
		{ print }
	' "$_file" >"$_file.cbpp-tmp"

	commit_tmp "$_file" "${_key}: ${_val}"
}

# write_file FILE MODE - generate a whole file from stdin, only touching it
# when the content actually differs.
write_file() {
	_file=$1
	_mode=$2

	mkdir -p "$(dirname "$_file")"
	cat >"$_file.cbpp-tmp"

	commit_tmp "$_file" "regenerated"
	[ -f "$_file" ] && chmod "$_mode" "$_file"
	return 0
}

# remove_file FILE - drop a generated file that the current settings no longer
# call for, so a disabled option cannot leave a stale artefact behind.
remove_file() {
	_file=$1

	[ -e "$_file" ] || return 0

	CHANGED=$((CHANGED + 1))
	if $CHECK; then
		note "would remove $_file"
	else
		rm -f "$_file"
		note "$_file: removed"
	fi
}

GEN="GENERATED by scripts/cbpp-apply from cbpp.conf - do not edit by hand."

# ------------------------------------------------------------ config/common --

set_key config/common LB_APT_HTTP_PROXY "$CBPP_APT_PROXY"
set_key config/common LB_CACHE_INDICES "$CBPP_CACHE_INDICES"
set_key config/common LB_INITRAMFS_COMPRESSION "$CBPP_INITRAMFS_COMPRESSION"

# --------------------------------------------------------- config/bootstrap --

set_key config/bootstrap LB_ARCHITECTURE "$CBPP_ARCH"

for _k in LB_DISTRIBUTION LB_DISTRIBUTION_CHROOT LB_PARENT_DISTRIBUTION_CHROOT \
	LB_DISTRIBUTION_BINARY LB_PARENT_DISTRIBUTION_BINARY \
	LB_PARENT_DEBIAN_INSTALLER_DISTRIBUTION; do
	set_key config/bootstrap "$_k" "$CBPP_DISTRIBUTION"
done

for _k in LB_PARENT_MIRROR_BOOTSTRAP LB_PARENT_MIRROR_CHROOT \
	LB_PARENT_MIRROR_BINARY LB_PARENT_MIRROR_DEBIAN_INSTALLER \
	LB_MIRROR_BOOTSTRAP LB_MIRROR_CHROOT LB_MIRROR_BINARY \
	LB_MIRROR_DEBIAN_INSTALLER; do
	set_key config/bootstrap "$_k" "$CBPP_MIRROR"
done

for _k in LB_PARENT_MIRROR_CHROOT_SECURITY LB_PARENT_MIRROR_BINARY_SECURITY \
	LB_MIRROR_CHROOT_SECURITY LB_MIRROR_BINARY_SECURITY; do
	set_key config/bootstrap "$_k" "$CBPP_MIRROR_SECURITY"
done

# ------------------------------------------------------------ config/chroot --

# live-build appends "-${LB_LINUX_FLAVOURS_WITH_ARCH}" to every entry in
# LB_LINUX_PACKAGES (see chroot_linux-image), so CBPP_KERNEL must stay
# suffix-free.
set_key config/chroot LB_LINUX_PACKAGES "$CBPP_KERNEL"
set_key config/chroot LB_LINUX_FLAVOURS_WITH_ARCH "$CBPP_ARCH"
set_key config/chroot LB_CHROOT_SQUASHFS_COMPRESSION_TYPE "$CBPP_SQUASHFS_COMPRESSION"
set_key config/chroot LB_CHROOT_SQUASHFS_COMPRESSION_LEVEL "$CBPP_SQUASHFS_LEVEL"
set_key config/chroot LB_BACKPORTS "$CBPP_KERNEL_BACKPORTS"

# ------------------------------------------------------------ config/binary --

# @ISOVOLUME_TS@ is expanded by live-build at build time (binary_iso) into
# YYYYmmdd-HH:MM, so the label always carries the real build date.  Hardcoding
# an expanded timestamp - as this file used to - freezes it forever.
set_key config/binary LB_ISO_VOLUME "cbpp-${CBPP_VERSION}-@ISOVOLUME_TS@"
set_key config/binary LB_BOOTAPPEND_LIVE "$CBPP_BOOTAPPEND_LIVE"
set_key config/binary LB_BOOTAPPEND_LIVE_FAILSAFE "$CBPP_BOOTAPPEND_LIVE_FAILSAFE"
set_key config/binary LB_BOOTAPPEND_INSTALL "$CBPP_BOOTAPPEND_INSTALL"
set_key config/binary LB_MEMTEST "$CBPP_MEMTEST"
set_key config/binary LB_ZSYNC "$CBPP_ZSYNC"
set_key config/binary LB_DEBIAN_INSTALLER_DISTRIBUTION "$CBPP_DISTRIBUTION"

# ------------------------------------------------------------- config/build --

set_field config/build Architecture "$CBPP_ARCH"
set_field config/build Distribution "$CBPP_DISTRIBUTION"
set_field config/build Mirror-Bootstrap "$CBPP_MIRROR"

# ---------------------------------------------------------- config/archives --

for _f in config/archives/cbpp.list.binary config/archives/cbpp.list.chroot; do
	write_file "$_f" 644 <<EOF
# $GEN
deb ${CBPP_PACKAGES_URL}/${CBPP_DISTRIBUTION} ${CBPP_DISTRIBUTION} main
EOF
done

# ------------------------------------------------------- backports kernel --

# Pinning is what actually selects the kernel.  chroot_prep installs
# config/archives/*.pref.chroot into the chroot's apt preferences before
# chroot_linux-image and chroot_install-packages run, so live-build's own
# "${CBPP_KERNEL}-${CBPP_ARCH}" install already resolves to the backports
# version - one download, no second kernel to autoremove afterwards.
#
# The hook then asserts the pin took effect.  Without it a pin that silently
# fails to match would just hand you a stable kernel in a release image.
#
# Both config/hooks/normal and config/hooks/live must stay non-empty:
# chroot_hooks only enters its hook loop when normal/*.chroot exists AND
# live/*.chroot (or *.container) exists.  Emptying either one silently
# disables *all* hooks.
if [ "$CBPP_KERNEL_BACKPORTS" = "true" ]; then
	write_file config/archives/cbpp-backports.pref.chroot 644 <<EOF
# $GEN
#
# Take the kernel from ${CBPP_DISTRIBUTION}-backports, leave everything else on
# stable.  live-build removes this file again at the end of the chroot stage,
# so it does not leak into the installed system.
Package: linux-image-${CBPP_ARCH} linux-image-*-${CBPP_ARCH} linux-headers-${CBPP_ARCH} linux-headers-*-${CBPP_ARCH}
Pin: release n=${CBPP_DISTRIBUTION}-backports
Pin-Priority: 990
EOF

	write_file config/hooks/normal/0990-backports-kernel.hook.chroot 755 <<EOF
#!/bin/sh
# $GEN
#
# Fail the build loudly if the backports kernel pin did not take.
set -e

VERSION="\$(dpkg-query -W -f='\${Version}' "linux-image-${CBPP_ARCH}")"

case "\$VERSION" in
*bpo*)
	echo "I: kernel from ${CBPP_DISTRIBUTION}-backports: \$VERSION"
	;;
*)
	echo "E: CBPP_KERNEL_BACKPORTS is enabled but linux-image-${CBPP_ARCH} is \$VERSION," >&2
	echo "E: which did not come from ${CBPP_DISTRIBUTION}-backports. Check LB_BACKPORTS and" >&2
	echo "E: config/archives/cbpp-backports.pref.chroot." >&2
	exit 1
	;;
esac
EOF
else
	remove_file config/archives/cbpp-backports.pref.chroot
	write_file config/hooks/normal/0990-backports-kernel.hook.chroot 755 <<EOF
#!/bin/sh
# $GEN
# CBPP_KERNEL_BACKPORTS is disabled in cbpp.conf; staying on the stable kernel.
exit 0
EOF
fi

# -------------------------------------------------------------------- zram --

ZRAM_CONF=config/includes.chroot_after_packages/etc/systemd/zram-generator.conf
ZRAM_SYSCTL=config/includes.chroot_after_packages/etc/sysctl.d/99-cbpp-zram.conf
EARLYOOM_CONF=config/includes.chroot_after_packages/etc/default/earlyoom
GEN_PKG_LIST=config/package-lists/cbpp-generated.list.chroot

# These land under includes.chroot_after_packages, which is copied in after the
# package install, so they win over the conffiles the packages ship.
if [ "$CBPP_ZRAM" = "true" ]; then
	write_file "$ZRAM_CONF" 644 <<EOF
# $GEN
#
# zram-generator turns this into systemd-zram-setup@zram0.service at boot.

[zram0]
zram-size = ${CBPP_ZRAM_SIZE}
compression-algorithm = ${CBPP_ZRAM_ALGORITHM}
swap-priority = ${CBPP_ZRAM_PRIORITY}

# Let the kernel release backing store as pages are freed.
options = discard
EOF

	write_file "$ZRAM_SYSCTL" 644 <<EOF
# $GEN
#
# Kernel vm defaults assume swap is a slow disk. With swap in compressed RAM
# the trade-offs invert: swapping is cheap, and readahead is pure waste.

# Bias strongly towards swapping anonymous pages out (ceiling is 200).
vm.swappiness = ${CBPP_VM_SWAPPINESS}

# Disable swap readahead: 2^0 = 1 page, i.e. only what was asked for.
vm.page-cluster = ${CBPP_VM_PAGE_CLUSTER}

# Do not inflate watermarks after fragmentation events.
vm.watermark_boost_factor = ${CBPP_VM_WATERMARK_BOOST_FACTOR}

# Begin reclaim earlier so compression keeps up under pressure.
vm.watermark_scale_factor = ${CBPP_VM_WATERMARK_SCALE_FACTOR}
EOF
else
	remove_file "$ZRAM_CONF"
	remove_file "$ZRAM_SYSCTL"
fi

if [ "$CBPP_EARLYOOM" = "true" ]; then
	write_file "$EARLYOOM_CONF" 644 <<EOF
# $GEN
#
# Act at 5% free memory and 5% free swap rather than earlyoom's default 10%,
# because with zram "free swap" shrinks slowly and 10% fires too eagerly.
# -r 0 silences the periodic memory report, which otherwise fills the journal
# of a live session.
#
# --avoid keeps the session itself alive so the machine stays usable after a
# kill; --prefer names the processes that realistically cause the pressure.
EARLYOOM_ARGS="-r 0 -m 5 -s 5 --avoid '^(systemd|Xorg|openbox|lxdm|tint2|conky)\$' --prefer '^(firefox-esr|gimp|vlc|libreoffice)'"
EOF
else
	remove_file "$EARLYOOM_CONF"
fi

# live-build reads every config/package-lists/*.list.chroot, so the packages
# these settings need can live in their own generated list instead of being
# hand-merged into live.list.chroot.
# ----------------------------------------------------------------- firefox --

# /usr/lib/firefox-esr/browser/defaults is a symlink to this path, and Firefox
# reads every *.js in it at startup, in alphabetical order. The zz- prefix puts
# us after Debian's firefox.js and vendor.js. Adding a new file here avoids
# touching /etc/firefox-esr/firefox-esr.js, which is a conffile carrying
# Debian's own settings.
FF_PREFS=config/includes.chroot_after_packages/usr/share/firefox-esr/browser/defaults/preferences/zz-cbpp-lowmem.js

if [ "$CBPP_FIREFOX_LOWMEM" = "true" ]; then
	write_file "$FF_PREFS" 644 <<EOF
// $GEN
//
// Low-memory defaults for CBPP. These are defaults, not locks: anything here
// can still be changed in about:config, and the user's value wins.

// Unload background tabs under memory pressure instead of letting them get
// swapped out. Firefox ships this off.
pref("browser.tabs.unloadOnLowMemory", true);

// Site isolation. Off is a deliberate memory-for-security trade, see cbpp.conf.
pref("fission.autostart", ${CBPP_FIREFOX_FISSION});

// Content processes, down from the default of 8.
pref("dom.ipc.processCount", ${CBPP_FIREFOX_PROCESS_COUNT});

// Do not keep a spare content process warm for the next tab. It buys tab-open
// latency at the price of a whole idle process.
pref("dom.ipc.processPrelaunch.enabled", false);

// Do not retain rendered pages for instant back/forward. This is the bfcache;
// switching it off costs a reload on Back and saves the memory those pages held.
pref("browser.sessionhistory.max_total_viewers", 0);

// Write session state every minute rather than every 15 seconds, and remember
// far fewer closed tabs and windows - each one keeps its state in memory.
pref("browser.sessionstore.interval", 60000);
pref("browser.sessionstore.max_tabs_undo", 3);
pref("browser.sessionstore.max_windows_undo", 1);

// Cap the in-memory caches, which are otherwise sized from total RAM.
pref("browser.cache.memory.capacity", 32768);
pref("media.memory_cache_max_size", 8192);
pref("image.mem.surfacecache.max_size_kb", 32768);

// Background machinery that costs memory and network for no local benefit.
pref("extensions.pocket.enabled", false);
pref("browser.newtabpage.activity-stream.feeds.section.topstories", false);
pref("toolkit.telemetry.enabled", false);
EOF
else
	remove_file "$FF_PREFS"
fi

# --------------------------------------------------------------- wallpaper --

# nitrogen reads this at login via `nitrogen --restore` in the openbox
# autostart. It lands in /etc/skel, so both the live user that live-config
# creates and any account the installer creates start with it.
WALLPAPER_CFG=config/includes.chroot_after_packages/etc/skel/.config/nitrogen/bg-saved.cfg

if [ -n "$CBPP_WALLPAPER" ]; then
	[ -f "config/includes.chroot_after_packages${CBPP_WALLPAPER}" ] ||
		die "CBPP_WALLPAPER points at ${CBPP_WALLPAPER}, which is not shipped in includes.chroot_after_packages"

	write_file "$WALLPAPER_CFG" 644 <<EOF
# $GEN
[:0.0]
file=${CBPP_WALLPAPER}
mode=${CBPP_WALLPAPER_MODE}
bgcolor=${CBPP_WALLPAPER_BGCOLOR}
EOF
else
	remove_file "$WALLPAPER_CFG"
fi

# --------------------------------------------------------------- fastfetch --

FF_CONF=config/includes.chroot_after_packages/etc/xdg/fastfetch/config.jsonc
FF_PROFILE=config/includes.chroot_after_packages/etc/profile.d/cbpp-fastfetch.sh

FF_LOGO=config/includes.chroot_after_packages/usr/share/cbpp/logo.txt

if [ "$CBPP_FASTFETCH" = "true" ]; then
	# The shipped logo is the plain art from assets/ painted by
	# scripts/cbpp-logo-color, so the art stays editable in one uncoloured
	# place and the scheme is a single setting rather than a hand-tinted file.
	command -v python3 >/dev/null 2>&1 ||
		die "python3 is needed to colourise the logo (CBPP_FASTFETCH is on)"
	mkdir -p "$(dirname "$FF_LOGO")"
	scripts/cbpp-logo-color "$CBPP_LOGO_STYLE" assets/logo-plain.txt "$FF_LOGO.cbpp-tmp" ||
		die "cbpp-logo-color failed for style '$CBPP_LOGO_STYLE'"
	commit_tmp "$FF_LOGO" "logo painted '$CBPP_LOGO_STYLE'"
	[ -f "$FF_LOGO" ] && chmod 644 "$FF_LOGO"

	# /etc/xdg/fastfetch is one of fastfetch's own config search paths, so this
	# applies to every user without touching /etc/skel or anyone's dotfiles.
	#
	# file-raw, not file: the logo carries its own escape sequences now, and
	# "file" would replace them with a single flat colour. fastfetch still
	# measures the logo by visible width, so the info block stays aligned.
	write_file "$FF_CONF" 644 <<EOF
// $GEN
{
    "logo": {
        "type": "file-raw",
        "source": "/usr/share/cbpp/logo.txt",
        "padding": { "top": 1, "right": 3 }
    },
    "display": { "separator": "  " },
    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "wm",
        "terminal",
        "cpu",
        "memory",
        "swap",
        "disk",
        "break",
        "colors"
    ]
}
EOF
else
	remove_file "$FF_CONF"
fi

if [ "$CBPP_FASTFETCH" = "true" ] && [ "$CBPP_FASTFETCH_ON_LOGIN" = "true" ]; then
	write_file "$FF_PROFILE" 644 <<EOF
# $GEN
#
# Show the banner on interactive login shells only. Without the guards this
# would also fire for scp, rsync-over-ssh and other non-interactive sessions,
# whose protocols break the moment anything unexpected lands on stdout.

if command -v fastfetch >/dev/null 2>&1 && [ -t 1 ] && [ "\${TERM:-dumb}" != "dumb" ]; then
	case \$- in
	*i*) fastfetch ;;
	esac
fi
EOF
else
	remove_file "$FF_PROFILE"
fi

# ----------------------------------------------------- generated packages --

GEN_PKGS=""
add_pkg() { GEN_PKGS="${GEN_PKGS}${GEN_PKGS:+
}$1"; }

[ "$CBPP_ZRAM" = "true" ] && add_pkg systemd-zram-generator
[ "$CBPP_EARLYOOM" = "true" ] && add_pkg earlyoom
[ "$CBPP_FASTFETCH" = "true" ] && add_pkg fastfetch

if [ -n "$GEN_PKGS" ]; then
	write_file "$GEN_PKG_LIST" 644 <<EOF
# $GEN
$GEN_PKGS
EOF
else
	remove_file "$GEN_PKG_LIST"
fi

# ------------------------------------------------ apt sources in the image --

write_file config/includes.chroot_after_packages/usr/lib/cbpp/apt-setup 755 <<EOF
#!/bin/bash -ex
# $GEN

if [[ -f /etc/apt/sources.list ]] && [[ ! -f /etc/apt/sources.list.d/debian.sources ]]; then
cat << SOURCES > /etc/apt/sources.list.d/debian.sources
# Add 'deb-src' to Types line for source packages
Types: deb
URIs: ${CBPP_MIRROR}
Suites: ${CBPP_DISTRIBUTION} ${CBPP_DISTRIBUTION}-updates ${CBPP_DISTRIBUTION}-backports
Components: main contrib non-free non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg

Types: deb
URIs: http://security.debian.org/debian-security/
Suites: ${CBPP_DISTRIBUTION}-security
Components: main contrib non-free non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
SOURCES
rm -f /etc/apt/sources.list
rm -f /etc/apt/sources.list~
fi

systemctl disable cbpp-apt-setup
rm -f /usr/lib/systemd/system/cbpp-apt-setup.service
rm -rf /usr/lib/cbpp
EOF

# -------------------------------------------------------------------------- --

if [ "$CHANGED" -eq 0 ]; then
	$QUIET || echo "cbpp-apply: config/ already matches cbpp.conf"
	exit 0
fi

if $CHECK; then
	echo "cbpp-apply: config/ is out of sync with cbpp.conf ($CHANGED item(s)) - run 'make apply'" >&2
	exit 1
fi

$QUIET || echo "cbpp-apply: updated $CHANGED item(s)"
