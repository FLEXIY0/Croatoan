#!/bin/sh
# cbpp-apply - stamp cbpp.conf into the live-build tree under config/.
#
# Every value this script writes is owned by cbpp.conf.  Keys it does not know
# about are left exactly as they are, so hand-edits to unrelated live-build
# options survive.  Running it twice in a row is a no-op.
#
# Usage: scripts/cbpp-apply [--quiet] [--check]
#
#   --quiet  only report the summary line
#   --check  report what would change and exit 1 if anything would, without
#            writing.  Used by `make lint` to catch a config/ tree that has
#            drifted away from cbpp.conf.

set -eu

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$ROOT"

QUIET=false
CHECK=false
for _arg in "$@"; do
	case $_arg in
	--quiet) QUIET=true ;;
	--check) CHECK=true ;;
	*) echo "cbpp-apply: unknown option: $_arg" >&2; exit 2 ;;
	esac
done

CHANGED=0

die() { echo "cbpp-apply: $*" >&2; exit 1; }
note() { $QUIET || echo "  $*"; }

[ -f cbpp.conf ] || die "cbpp.conf not found in $ROOT"
# shellcheck disable=SC1091
. ./cbpp.conf

# --------------------------------------------------------------- helpers --

# set_key FILE KEY VALUE - rewrite `KEY="..."` in a live-build config file.
# Fails loudly if the key is absent, so a live-build format change surfaces
# here instead of silently dropping a setting.
set_key() {
	_file=$1
	_key=$2
	_val=$3

	[ -f "$_file" ] || die "$_file: no such file"
	grep -q "^${_key}=" "$_file" || die "$_file: key ${_key} not found"
	case $_val in
	*'"'*) die "${_key}: value must not contain a double quote" ;;
	esac

	awk -v k="$_key" -v v="$_val" '
		index($0, k "=") == 1 { print k "=\"" v "\""; next }
		{ print }
	' "$_file" >"$_file.cbpp-tmp"

	commit_tmp "$_file" "${_key}=\"${_val}\""
}

# commit_tmp FILE DESCRIPTION - promote FILE.cbpp-tmp over FILE unless it is
# byte-identical, honouring --check.
commit_tmp() {
	_f=$1
	_desc=$2

	if [ -f "$_f" ] && cmp -s "$_f" "$_f.cbpp-tmp"; then
		rm -f "$_f.cbpp-tmp"
		return 0
	fi

	CHANGED=$((CHANGED + 1))
	if $CHECK; then
		rm -f "$_f.cbpp-tmp"
		note "would update $_f: $_desc"
	else
		mv "$_f.cbpp-tmp" "$_f"
		note "$_f: $_desc"
	fi
}

# set_field FILE KEY VALUE - same idea for the `Key: value` format of
# config/build.
set_field() {
	_file=$1
	_key=$2
	_val=$3

	[ -f "$_file" ] || die "$_file: no such file"
	grep -q "^${_key}:" "$_file" || die "$_file: field ${_key} not found"

	awk -v k="$_key" -v v="$_val" '
		index($0, k ":") == 1 { print k ": " v; next }
		{ print }
	' "$_file" >"$_file.cbpp-tmp"

	commit_tmp "$_file" "${_key}: ${_val}"
}

# write_file FILE MODE - generate a whole file from stdin, only touching it
# when the content actually differs.
write_file() {
	_file=$1
	_mode=$2

	mkdir -p "$(dirname "$_file")"
	cat >"$_file.cbpp-tmp"

	commit_tmp "$_file" "regenerated"
	[ -f "$_file" ] && chmod "$_mode" "$_file"
	return 0
}

# remove_file FILE - drop a generated file that the current settings no longer
# call for, so a disabled option cannot leave a stale artefact behind.
remove_file() {
	_file=$1

	[ -e "$_file" ] || return 0

	CHANGED=$((CHANGED + 1))
	if $CHECK; then
		note "would remove $_file"
	else
		rm -f "$_file"
		note "$_file: removed"
	fi
}

GEN="GENERATED by scripts/cbpp-apply from cbpp.conf - do not edit by hand."

# Branding, derived once. BRAND is the display name that goes in front of a
# human; BRAND_ID is the lowercase single-word form for volume labels and
# other places that will not take punctuation.
if [ -n "$CBPP_BRANDING" ]; then
	BRAND="$CBPP_BRANDING"
	BRAND_ID=$(printf '%s' "$CBPP_BRANDING" | tr 'A-Z' 'a-z' | tr -cd 'a-z0-9-')
	[ -n "$BRAND_ID" ] || die "CBPP_BRANDING has no usable lowercase form"
else
	BRAND="CrunchBang++"
	BRAND_ID="cbpp"
fi

# ------------------------------------------------------------ config/common --

set_key config/common LB_APT_HTTP_PROXY "$CBPP_APT_PROXY"
set_key config/common LB_CACHE_INDICES "$CBPP_CACHE_INDICES"
set_key config/common LB_INITRAMFS_COMPRESSION "$CBPP_INITRAMFS_COMPRESSION"

# --------------------------------------------------------- config/bootstrap --

set_key config/bootstrap LB_ARCHITECTURE "$CBPP_ARCH"

for _k in LB_DISTRIBUTION LB_DISTRIBUTION_CHROOT LB_PARENT_DISTRIBUTION_CHROOT \
	LB_DISTRIBUTION_BINARY LB_PARENT_DISTRIBUTION_BINARY \
	LB_PARENT_DEBIAN_INSTALLER_DISTRIBUTION; do
	set_key config/bootstrap "$_k" "$CBPP_DISTRIBUTION"
done

for _k in LB_PARENT_MIRROR_BOOTSTRAP LB_PARENT_MIRROR_CHROOT \
	LB_PARENT_MIRROR_BINARY LB_PARENT_MIRROR_DEBIAN_INSTALLER \
	LB_MIRROR_BOOTSTRAP LB_MIRROR_CHROOT LB_MIRROR_BINARY \
	LB_MIRROR_DEBIAN_INSTALLER; do
	set_key config/bootstrap "$_k" "$CBPP_MIRROR"
done

for _k in LB_PARENT_MIRROR_CHROOT_SECURITY LB_PARENT_MIRROR_BINARY_SECURITY \
	LB_MIRROR_CHROOT_SECURITY LB_MIRROR_BINARY_SECURITY; do
	set_key config/bootstrap "$_k" "$CBPP_MIRROR_SECURITY"
done

# ------------------------------------------------------------ config/chroot --

# live-build appends "-${LB_LINUX_FLAVOURS_WITH_ARCH}" to every entry in
# LB_LINUX_PACKAGES (see chroot_linux-image), so CBPP_KERNEL must stay
# suffix-free.
set_key config/chroot LB_LINUX_PACKAGES "$CBPP_KERNEL"
set_key config/chroot LB_LINUX_FLAVOURS_WITH_ARCH "$CBPP_ARCH"
set_key config/chroot LB_CHROOT_SQUASHFS_COMPRESSION_TYPE "$CBPP_SQUASHFS_COMPRESSION"
set_key config/chroot LB_CHROOT_SQUASHFS_COMPRESSION_LEVEL "$CBPP_SQUASHFS_LEVEL"
set_key config/chroot LB_BACKPORTS "$CBPP_KERNEL_BACKPORTS"

# ------------------------------------------------------------ config/binary --

# @ISOVOLUME_TS@ is expanded by live-build at build time (binary_iso) into
# YYYYmmdd-HH:MM, so the label always carries the real build date.  Hardcoding
# an expanded timestamp - as this file used to - freezes it forever.
set_key config/binary LB_ISO_VOLUME "${BRAND_ID}-${CBPP_VERSION}-@ISOVOLUME_TS@"

# The hostname lives in the live boot cmdline, but it is a branding decision,
# so CBPP_HOSTNAME owns it and the token in CBPP_BOOTAPPEND_LIVE is rewritten
# rather than being a second place to keep in sync.
_bootappend_live=$(printf '%s\n' "$CBPP_BOOTAPPEND_LIVE" |
	sed "s/hostname=[^ ]*/hostname=${CBPP_HOSTNAME}/")

# The live session gets the same kernel command line the installed system will,
# so what you try from the ISO is what you end up running. The installed side
# comes from the grub drop-in further down.
[ "$CBPP_MITIGATIONS" = "off" ] &&
	_bootappend_live="${_bootappend_live} mitigations=off"

set_key config/binary LB_BOOTAPPEND_LIVE "$_bootappend_live"
set_key config/binary LB_BOOTAPPEND_LIVE_FAILSAFE "$CBPP_BOOTAPPEND_LIVE_FAILSAFE"
set_key config/binary LB_BOOTAPPEND_INSTALL "$CBPP_BOOTAPPEND_INSTALL"
set_key config/binary LB_MEMTEST "$CBPP_MEMTEST"
set_key config/binary LB_ZSYNC "$CBPP_ZSYNC"
set_key config/binary LB_DEBIAN_INSTALLER_DISTRIBUTION "$CBPP_DISTRIBUTION"
set_key config/binary LB_ISO_APPLICATION "$CBPP_ISO_APPLICATION"
set_key config/binary LB_ISO_PUBLISHER "$CBPP_ISO_PUBLISHER"
set_key config/binary LB_HDD_LABEL "$CBPP_HDD_LABEL"

# ------------------------------------------------------------- config/build --

set_field config/build Architecture "$CBPP_ARCH"
set_field config/build Distribution "$CBPP_DISTRIBUTION"
set_field config/build Mirror-Bootstrap "$CBPP_MIRROR"

# ---------------------------------------------------------- config/archives --

for _f in config/archives/cbpp.list.binary config/archives/cbpp.list.chroot; do
	write_file "$_f" 644 <<EOF
# $GEN
deb ${CBPP_PACKAGES_URL}/${CBPP_DISTRIBUTION} ${CBPP_DISTRIBUTION} main
EOF
done

# ------------------------------------------------------- backports kernel --

# Pinning is what actually selects the kernel.  chroot_prep installs
# config/archives/*.pref.chroot into the chroot's apt preferences before
# chroot_linux-image and chroot_install-packages run, so live-build's own
# "${CBPP_KERNEL}-${CBPP_ARCH}" install already resolves to the backports
# version - one download, no second kernel to autoremove afterwards.
#
# The hook then asserts the pin took effect.  Without it a pin that silently
# fails to match would just hand you a stable kernel in a release image.
#
# Both config/hooks/normal and config/hooks/live must stay non-empty:
# chroot_hooks only enters its hook loop when normal/*.chroot exists AND
# live/*.chroot (or *.container) exists.  Emptying either one silently
# disables *all* hooks.
if [ "$CBPP_KERNEL_BACKPORTS" = "true" ]; then
	write_file config/archives/cbpp-backports.pref.chroot 644 <<EOF
# $GEN
#
# Take the kernel from ${CBPP_DISTRIBUTION}-backports, leave everything else on
# stable.  live-build removes this file again at the end of the chroot stage,
# so it does not leak into the installed system.
Package: linux-image-${CBPP_ARCH} linux-image-*-${CBPP_ARCH} linux-headers-${CBPP_ARCH} linux-headers-*-${CBPP_ARCH}
Pin: release n=${CBPP_DISTRIBUTION}-backports
Pin-Priority: 990
EOF

	write_file config/hooks/normal/0990-backports-kernel.hook.chroot 755 <<EOF
#!/bin/sh
# $GEN
#
# Fail the build loudly if the backports kernel pin did not take.
set -e

VERSION="\$(dpkg-query -W -f='\${Version}' "linux-image-${CBPP_ARCH}")"

case "\$VERSION" in
*bpo*)
	echo "I: kernel from ${CBPP_DISTRIBUTION}-backports: \$VERSION"
	;;
*)
	echo "E: CBPP_KERNEL_BACKPORTS is enabled but linux-image-${CBPP_ARCH} is \$VERSION," >&2
	echo "E: which did not come from ${CBPP_DISTRIBUTION}-backports. Check LB_BACKPORTS and" >&2
	echo "E: config/archives/cbpp-backports.pref.chroot." >&2
	exit 1
	;;
esac
EOF
else
	remove_file config/archives/cbpp-backports.pref.chroot
	write_file config/hooks/normal/0990-backports-kernel.hook.chroot 755 <<EOF
#!/bin/sh
# $GEN
# CBPP_KERNEL_BACKPORTS is disabled in cbpp.conf; staying on the stable kernel.
exit 0
EOF
fi

# -------------------------------------------------------------------- zram --

ZRAM_CONF=config/includes.chroot_after_packages/etc/systemd/zram-generator.conf
ZRAM_SYSCTL=config/includes.chroot_after_packages/etc/sysctl.d/99-cbpp-zram.conf
EARLYOOM_CONF=config/includes.chroot_after_packages/etc/default/earlyoom
GEN_PKG_LIST=config/package-lists/cbpp-generated.list.chroot

# These land under includes.chroot_after_packages, which is copied in after the
# package install, so they win over the conffiles the packages ship.
if [ "$CBPP_ZRAM" = "true" ]; then
	write_file "$ZRAM_CONF" 644 <<EOF
# $GEN
#
# zram-generator turns this into systemd-zram-setup@zram0.service at boot.

[zram0]
zram-size = ${CBPP_ZRAM_SIZE}
compression-algorithm = ${CBPP_ZRAM_ALGORITHM}
swap-priority = ${CBPP_ZRAM_PRIORITY}

# Let the kernel release backing store as pages are freed.
options = discard
EOF

	write_file "$ZRAM_SYSCTL" 644 <<EOF
# $GEN
#
# Kernel vm defaults assume swap is a slow disk. With swap in compressed RAM
# the trade-offs invert: swapping is cheap, and readahead is pure waste.

# Bias strongly towards swapping anonymous pages out (ceiling is 200).
vm.swappiness = ${CBPP_VM_SWAPPINESS}

# Disable swap readahead: 2^0 = 1 page, i.e. only what was asked for.
vm.page-cluster = ${CBPP_VM_PAGE_CLUSTER}

# Do not inflate watermarks after fragmentation events.
vm.watermark_boost_factor = ${CBPP_VM_WATERMARK_BOOST_FACTOR}

# Begin reclaim earlier so compression keeps up under pressure.
vm.watermark_scale_factor = ${CBPP_VM_WATERMARK_SCALE_FACTOR}
EOF
else
	remove_file "$ZRAM_CONF"
	remove_file "$ZRAM_SYSCTL"
fi

if [ "$CBPP_EARLYOOM" = "true" ]; then
	write_file "$EARLYOOM_CONF" 644 <<EOF
# $GEN
#
# Act at 5% free memory and 5% free swap rather than earlyoom's default 10%,
# because with zram "free swap" shrinks slowly and 10% fires too eagerly.
# -r 0 silences the periodic memory report, which otherwise fills the journal
# of a live session.
#
# --avoid keeps the session itself alive so the machine stays usable after a
# kill; --prefer names the processes that realistically cause the pressure.
EARLYOOM_ARGS="-r 0 -m 5 -s 5 --avoid '^(systemd|Xorg|openbox|lxdm|tint2|conky)\$' --prefer '^(firefox-esr|gimp|vlc|libreoffice)'"
EOF
else
	remove_file "$EARLYOOM_CONF"
fi

# live-build reads every config/package-lists/*.list.chroot, so the packages
# these settings need can live in their own generated list instead of being
# hand-merged into live.list.chroot.
# ----------------------------------------------------------------- firefox --

# /usr/lib/firefox-esr/browser/defaults is a symlink to this path, and Firefox
# reads every *.js in it at startup, in alphabetical order. The zz- prefix puts
# us after Debian's firefox.js and vendor.js. Adding a new file here avoids
# touching /etc/firefox-esr/firefox-esr.js, which is a conffile carrying
# Debian's own settings.
FF_PREFS=config/includes.chroot_after_packages/usr/share/firefox-esr/browser/defaults/preferences/zz-cbpp-lowmem.js

if [ "$CBPP_FIREFOX_LOWMEM" = "true" ]; then
	# Built up first and interpolated below, so the file is still written in
	# one piece: appending after write_file would corrupt the tree under
	# --check, where write_file deliberately does not write.
	_ff_video=""
	if [ "$CBPP_FIREFOX_VIDEO" = "h264" ]; then
		_ff_video=$(cat <<'EOF'

// -- video, on a GPU that predates VP9 -------------------------------------
//
// Steering the codec is the whole game here. A GMA 4500MHD decodes H.264 in
// hardware and knows nothing about VP9 or AV1, so when YouTube serves VP9 -
// which it does by default - the CPU decodes it, and 720p on a 1.4 GHz Core 2
// Duo does not keep up. Refusing WebM inside Media Source Extensions makes
// YouTube fall back to H.264, which the GPU takes off the CPU entirely.
//
// The cost: a site that offers nothing but VP9 or AV1 will not play video.
pref("media.mediasource.webm.enabled", false);
pref("media.av1.enabled", false);

// Ask for the hardware decoder, and ask again past the driver blocklist -
// which is what otherwise turns this off silently on a GPU this old.
pref("media.ffmpeg.vaapi.enabled", true);
pref("media.hardware-video-decoding.force-enabled", true);
EOF
)
	fi

	write_file "$FF_PREFS" 644 <<EOF
// $GEN
//
// Low-memory defaults for CBPP. These are defaults, not locks: anything here
// can still be changed in about:config, and the user's value wins.

// Unload background tabs under memory pressure instead of letting them get
// swapped out. Firefox ships this off.
pref("browser.tabs.unloadOnLowMemory", true);

// Site isolation. Off is a deliberate memory-for-security trade, see cbpp.conf.
pref("fission.autostart", ${CBPP_FIREFOX_FISSION});

// Content processes, down from the default of 8.
pref("dom.ipc.processCount", ${CBPP_FIREFOX_PROCESS_COUNT});

// Do not keep a spare content process warm for the next tab. It buys tab-open
// latency at the price of a whole idle process.
pref("dom.ipc.processPrelaunch.enabled", false);

// Do not retain rendered pages for instant back/forward. This is the bfcache;
// switching it off costs a reload on Back and saves the memory those pages held.
pref("browser.sessionhistory.max_total_viewers", 0);

// Write session state every minute rather than every 15 seconds, and remember
// far fewer closed tabs and windows - each one keeps its state in memory.
pref("browser.sessionstore.interval", 60000);
pref("browser.sessionstore.max_tabs_undo", 3);
pref("browser.sessionstore.max_windows_undo", 1);

// Cap the in-memory caches, which are otherwise sized from total RAM.
pref("browser.cache.memory.capacity", 32768);
pref("media.memory_cache_max_size", 8192);
pref("image.mem.surfacecache.max_size_kb", 32768);

// Background machinery that costs memory and network for no local benefit.
pref("extensions.pocket.enabled", false);
pref("browser.newtabpage.activity-stream.feeds.section.topstories", false);
pref("toolkit.telemetry.enabled", false);
${_ff_video}
EOF
else
	remove_file "$FF_PREFS"
fi

# ------------------------------------------------------------- networking --

IPV6_NM=config/includes.chroot_after_packages/etc/NetworkManager/conf.d/99-cbpp-ipv6.conf
IPV6_SYSCTL=config/includes.chroot_after_packages/etc/sysctl.d/99-cbpp-ipv6.conf

# NetworkManager merges every [connection-*] block in conf.d; the suffix exists
# only so several files can each contribute defaults.
if [ "$CBPP_IPV6" = "disabled" ]; then
	write_file "$IPV6_SYSCTL" 644 <<EOF
# $GEN
#
# IPv6 off on real interfaces. Loopback is left alone on purpose: disabling
# ::1 breaks software that binds it, and buys nothing on the network side.

net.ipv6.conf.all.disable_ipv6 = 1
net.ipv6.conf.default.disable_ipv6 = 1
EOF

	write_file "$IPV6_NM" 644 <<EOF
# $GEN
#
# Without this NetworkManager still runs IPv6 autoconfiguration on every
# connection and waits for it before reporting the link up, which shows up as
# a delay at login even with the sysctls above in place.

[connection-cbpp-ipv6]
ipv6.method=disabled
EOF
else
	write_file "$IPV6_SYSCTL" 644 <<EOF
# $GEN
#
# IPv6 is enabled; nothing to switch off here. Privacy handling lives in the
# NetworkManager drop-in next to this file.
EOF

	write_file "$IPV6_NM" 644 <<EOF
# $GEN
#
# Prefer RFC 4941 temporary addresses, so the interface identifier stops being
# a stable fingerprint of this machine's hardware on every network it joins.
# NetworkManager ships this in its own anonymity example and leaves it unset.

[connection-cbpp-ipv6]
ipv6.ip6-privacy=2
EOF
fi

# -------------------------------------------------------------- screenshot --

SHOT_BIN=config/includes.chroot_after_packages/usr/bin/cbpp-screenshot
SHOT_HOOK=config/hooks/normal/0995-openbox-screenshot.hook.chroot

if [ "$CBPP_SCREENSHOT" = "true" ]; then
	write_file "$SHOT_BIN" 755 <<EOF
#!/bin/sh
# $GEN
#
# Grab the whole screen, save it, and say where it went. No dialog, no viewer
# popping up over the thing you just captured.
set -eu

if ! command -v scrot >/dev/null 2>&1; then
	echo "cbpp-screenshot: scrot is not installed" >&2
	exit 1
fi

# CBPP's own user setup creates ~/images; fall back for anyone who removed it.
for _d in "\$HOME/images" "\$HOME/Pictures" "\$HOME"; do
	if [ -d "\$_d" ]; then
		DIR=\$_d
		break
	fi
done

FILE="\$DIR/screenshot-\$(date +%Y-%m-%d-%H%M%S).png"
scrot "\$FILE"

if command -v notify-send >/dev/null 2>&1; then
	notify-send -i "\$FILE" "Screenshot saved" "\$FILE" || true
fi

echo "\$FILE"
EOF

	# chroot_hooks runs after chroot_includes_after_packages and after the
	# packages are installed, so this can amend the menu that cbpp-configs
	# ships rather than us shipping a whole copy of it and owning every future
	# change to the CBPP menu.
	write_file "$SHOT_HOOK" 755 <<'EOF'
#!/bin/sh
# GENERATED by scripts/cbpp-apply from cbpp.conf - do not edit by hand.
#
# Add a one-click "Screenshot" entry to the Openbox root menu. CBPP already has
# one under Graphics > Take Screenshot > Now, but that is three levels deep and
# opens an image viewer afterwards.
set -e

MENU=/etc/skel/.config/openbox/menu.xml

if [ ! -f "$MENU" ]; then
	echo "I: $MENU not present, skipping the screenshot menu entry"
	exit 0
fi

if grep -q "cbpp-screenshot" "$MENU"; then
	echo "I: screenshot entry already present"
	exit 0
fi

# Anchor on the Media Player launcher, the last item in the root menu's
# top group. Fail rather than silently drop the feature if it moves.
grep -q "<execute>vlc</execute>" "$MENU" ||
	{ echo "E: cannot find the root-menu anchor in $MENU" >&2; exit 1; }

awk '
	/<execute>vlc<\/execute>/ { seen = 1 }
	{ print }
	seen && /<\/item>/ && !done {
		print "    <item label=\"Screenshot\">"
		print "      <action name=\"Execute\">"
		print "        <execute>cbpp-screenshot</execute>"
		print "      </action>"
		print "    </item>"
		done = 1
	}
' "$MENU" >"$MENU.new"

mv "$MENU.new" "$MENU"

# openbox ships a schema for this file; use it if xmllint is around.
if command -v xmllint >/dev/null 2>&1; then
	xmllint --noout "$MENU" ||
		{ echo "E: menu.xml is not well-formed after editing" >&2; exit 1; }
fi

echo "I: added the Screenshot entry to the Openbox root menu"

# The stock scrot entries contain "&amp;amp;", which reaches the shell as
# "&amp;" - so it backgrounds the mv and then tries to run a command called
# "amp". It half-works by accident, which is why nobody noticed. The same
# entries in rc.xml use "&amp;" correctly, so this is a double-escape in
# menu.xml alone.
if grep -q "&amp;amp;" "$MENU"; then
	sed -i 's/&amp;amp;/\&amp;/g' "$MENU"
	echo "I: fixed the double-escaped ampersand in the scrot menu entries"
fi
EOF
else
	remove_file "$SHOT_BIN"
	remove_file "$SHOT_HOOK"
fi

# ------------------------------------------------------------------- conky --

CONKY_HOOK=config/hooks/normal/0998-conky.hook.chroot
ZRAM_STATUS=config/includes.chroot_after_packages/usr/bin/cbpp-zram-status

if [ "$CBPP_CONKY_PANEL" = "true" ]; then
	# conky has no zram object, so give it one line of output to read. The
	# interesting number is not how full the device is but how well it is
	# compressing: mm_stat field 1 is what the data would occupy uncompressed,
	# field 2 is what it actually takes in RAM.
	write_file "$ZRAM_STATUS" 755 <<EOF
#!/bin/sh
# $GEN
set -eu

STAT=/sys/block/zram0/mm_stat

if [ ! -r "\$STAT" ]; then
	echo "off"
	exit 0
fi

awk '{
	if (\$2 > 0)
		printf "%.0fM at %.1fx", \$2 / 1048576, \$1 / \$2;
	else
		printf "empty";
}' "\$STAT"
EOF

	write_file "$CONKY_HOOK" 755 <<'EOF'
#!/bin/sh
# GENERATED by scripts/cbpp-apply from cbpp.conf - do not edit by hand.
#
# The shipped panel lists shortcuts that no longer describe the system: it
# predates the keybindings we add, so Super+q, Super+Return, the desktop
# numbers and Super+Shift+q are all missing from it. Rewrite the block to match
# what rc.xml actually binds, and add a zram line while we are here.
set -e

RC=/etc/skel/.conkyrc

if [ ! -f "$RC" ]; then
	echo "I: $RC not present, skipping the conky panel"
	exit 0
fi

if grep -q "cbpp-zram-status" "$RC"; then
	echo "I: conky panel already updated"
	exit 0
fi

grep -q "S H O R T C U T" "$RC" ||
	{ echo "E: no shortcut block in $RC to replace" >&2; exit 1; }
grep -q "Swap usage:" "$RC" ||
	{ echo "E: no swap line in $RC to anchor the zram line to" >&2; exit 1; }

awk '
	/^Swap usage:/ {
		print
		print "zram:$alignr${execi 10 cbpp-zram-status}"
		next
	}
	/^S H O R T C U T/ { shortcuts = 1 }
	shortcuts && /^\]\];/ {
		print "S H O R T C U T    K E Y S"
		print "${hr}"
		print "Super+Return$alignr Terminal"
		print "Super+q$alignr Close Window"
		print "Super+Space$alignr Main Menu"
		print "Super+Tab$alignr Client Menu"
		print "Alt+F2$alignr Run Dialog"
		print "Alt+F3$alignr Alt Menu"
		print "Super+1 / +2$alignr Switch Desktop"
		print "Super+Shift+1 / +2$alignr Move Window"
		print "Super+f$alignr File Manager"
		print "Super+e$alignr Editor"
		print "Super+w$alignr Web Browser"
		print "Super+m$alignr Media Player"
		print "Super+h$alignr Task Manager"
		print "Super+v$alignr Volume Control"
		print "Super+l$alignr Lock Screen"
		print "Super+x$alignr Logout"
		print "PrtSc$alignr Screenshot"
		print ""
		shortcuts = 0
	}
	!shortcuts { print }
' "$RC" >"$RC.new"

mv "$RC.new" "$RC"
echo "I: conky panel now lists the real shortcuts and reports zram"
EOF
else
	remove_file "$CONKY_HOOK"
	remove_file "$ZRAM_STATUS"
fi

# --------------------------------------------------------------- clipboard --

CLIP_HOOK=config/hooks/normal/0997-openbox-clipboard.hook.chroot

if [ -n "$CBPP_CLIPBOARD" ]; then
	write_file "$CLIP_HOOK" 755 <<EOF
#!/bin/sh
# $GEN
#
# The openbox autostart launches parcellite, which trixie no longer carries.
# Point it at the replacement so the line actually starts something.
set -e

AUTOSTART=/etc/skel/.config/openbox/autostart

if [ ! -f "\$AUTOSTART" ]; then
	echo "I: \$AUTOSTART not present, skipping the clipboard manager"
	exit 0
fi

if grep -q "${CBPP_CLIPBOARD}" "\$AUTOSTART"; then
	echo "I: clipboard manager already set"
	exit 0
fi

grep -q "parcellite" "\$AUTOSTART" ||
	{ echo "E: no parcellite line in \$AUTOSTART to replace" >&2; exit 1; }

sed -i 's/parcellite/${CBPP_CLIPBOARD}/g' "\$AUTOSTART"
echo "I: clipboard manager is now ${CBPP_CLIPBOARD}"
EOF
else
	remove_file "$CLIP_HOOK"
fi

# --------------------------------------------------------------- keybinds --

KEYS_HOOK=config/hooks/normal/0996-openbox-keybinds.hook.chroot

if [ "$CBPP_KEYBINDS" = "true" ]; then
	write_file "$KEYS_HOOK" 755 <<'EOF'
#!/bin/sh
# GENERATED by scripts/cbpp-apply from cbpp.conf - do not edit by hand.
#
# Add the conventional Openbox keybindings CBPP does not ship. Everything here
# uses a key that rc.xml leaves free, so nothing existing is rebound - except
# Print, handled separately at the bottom.
set -e

RC=/etc/skel/.config/openbox/rc.xml

if [ ! -f "$RC" ]; then
	echo "I: $RC not present, skipping keybindings"
	exit 0
fi

if grep -q "cbpp classic keybindings" "$RC"; then
	echo "I: keybindings already present"
	exit 0
fi

grep -q "<keyboard>" "$RC" ||
	{ echo "E: no <keyboard> section in $RC" >&2; exit 1; }

# CBPP ships two desktops; W-F1..W-F4 already switch between them, but the
# number-row equivalents are what most people reach for.
awk '
	/<keyboard>/ && !done {
		print
		print "    <!-- cbpp classic keybindings -->"
		print "    <keybind key=\"W-q\">"
		print "      <action name=\"Close\"/>"
		print "    </keybind>"
		print "    <keybind key=\"W-Return\">"
		print "      <action name=\"Execute\">"
		print "        <command>x-terminal-emulator</command>"
		print "      </action>"
		print "    </keybind>"
		print "    <keybind key=\"W-1\">"
		print "      <action name=\"GoToDesktop\"><to>1</to></action>"
		print "    </keybind>"
		print "    <keybind key=\"W-2\">"
		print "      <action name=\"GoToDesktop\"><to>2</to></action>"
		print "    </keybind>"
		print "    <keybind key=\"W-S-1\">"
		print "      <action name=\"SendToDesktop\"><to>1</to></action>"
		print "    </keybind>"
		print "    <keybind key=\"W-S-2\">"
		print "      <action name=\"SendToDesktop\"><to>2</to></action>"
		print "    </keybind>"
		print "    <keybind key=\"W-S-q\">"
		print "      <action name=\"Execute\">"
		print "        <command>cbpp-exit</command>"
		print "      </action>"
		print "    </keybind>"
		done = 1
		next
	}
	{ print }
' "$RC" >"$RC.new"

mv "$RC.new" "$RC"

# Print opens the xfce4-screenshooter dialog by default. Everywhere else Print
# just takes the shot, so point it at cbpp-screenshot; the dialog is still one
# click away under Graphics > Take Screenshot > Screenshooter.
if [ -x /usr/bin/cbpp-screenshot ] && grep -q "xfce4-screenshooter" "$RC"; then
	sed -i 's|<command>xfce4-screenshooter</command>|<command>cbpp-screenshot</command>|' "$RC"
	echo "I: Print now takes a full-screen shot directly"
fi

if command -v xmllint >/dev/null 2>&1; then
	xmllint --noout "$RC" ||
		{ echo "E: rc.xml is not well-formed after editing" >&2; exit 1; }
fi

echo "I: added the classic keybindings to the Openbox config"
EOF
else
	remove_file "$KEYS_HOOK"
fi

# --------------------------------------------------------------- wallpaper --

# nitrogen reads this at login via `nitrogen --restore` in the openbox
# autostart. It lands in /etc/skel, so both the live user that live-config
# creates and any account the installer creates start with it.
WALLPAPER_CFG=config/includes.chroot_after_packages/etc/skel/.config/nitrogen/bg-saved.cfg

if [ -n "$CBPP_WALLPAPER" ]; then
	[ -f "config/includes.chroot_after_packages${CBPP_WALLPAPER}" ] ||
		die "CBPP_WALLPAPER points at ${CBPP_WALLPAPER}, which is not shipped in includes.chroot_after_packages"

	write_file "$WALLPAPER_CFG" 644 <<EOF
# $GEN
[:0.0]
file=${CBPP_WALLPAPER}
mode=${CBPP_WALLPAPER_MODE}
bgcolor=${CBPP_WALLPAPER_BGCOLOR}
EOF
else
	remove_file "$WALLPAPER_CFG"
fi

# --------------------------------------------------------------- fastfetch --

FF_CONF=config/includes.chroot_after_packages/etc/xdg/fastfetch/config.jsonc
FF_PROFILE=config/includes.chroot_after_packages/etc/profile.d/cbpp-fastfetch.sh

FF_LOGO=config/includes.chroot_after_packages/usr/share/cbpp/logo.txt

if [ "$CBPP_FASTFETCH" = "true" ]; then
	# The shipped logo is the plain art from assets/ painted by
	# scripts/cbpp-logo-color, so the art stays editable in one uncoloured
	# place and the scheme is a single setting rather than a hand-tinted file.
	command -v python3 >/dev/null 2>&1 ||
		die "python3 is needed to colourise the logo (CBPP_FASTFETCH is on)"
	mkdir -p "$(dirname "$FF_LOGO")"
	_size_flag=""
	[ "$CBPP_LOGO_SIZE" = "full" ] && _size_flag="--full"
	# shellcheck disable=SC2086
	[ -f "$CBPP_LOGO_ART" ] || die "CBPP_LOGO_ART: $CBPP_LOGO_ART: no such file"
	scripts/cbpp-logo-color $_size_flag "$CBPP_LOGO_STYLE" "$CBPP_LOGO_ART" "$FF_LOGO.cbpp-tmp" ||
		die "cbpp-logo-color failed for style '$CBPP_LOGO_STYLE'"
	commit_tmp "$FF_LOGO" "logo painted '$CBPP_LOGO_STYLE'"
	[ -f "$FF_LOGO" ] && chmod 644 "$FF_LOGO"

	# /etc/xdg/fastfetch is one of fastfetch's own config search paths, so this
	# applies to every user without touching /etc/skel or anyone's dotfiles.
	#
	# file-raw, not file: the logo carries its own escape sequences now, and
	# "file" would replace them with a single flat colour. fastfetch still
	# measures the logo by visible width, so the info block stays aligned.
	write_file "$FF_CONF" 644 <<EOF
// $GEN
{
    "logo": {
        "type": "file-raw",
        "source": "/usr/share/cbpp/logo.txt",
        "padding": { "top": 1, "right": 3 }
    },
    "display": { "separator": "  " },
    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "wm",
        "terminal",
        "cpu",
        "memory",
        "swap",
        {
            "type": "disk",
            "folders": "/"
        },
        "break",
        "colors"
    ]
}
EOF
else
	remove_file "$FF_CONF"
fi

if [ "$CBPP_FASTFETCH" = "true" ] && [ "$CBPP_FASTFETCH_ON_LOGIN" = "true" ]; then
	write_file "$FF_PROFILE" 644 <<EOF
# $GEN
#
# Show the banner on interactive login shells only. Without the guards this
# would also fire for scp, rsync-over-ssh and other non-interactive sessions,
# whose protocols break the moment anything unexpected lands on stdout.

if command -v fastfetch >/dev/null 2>&1 && [ -t 1 ] && [ "\${TERM:-dumb}" != "dumb" ]; then
	case \$- in
	*i*) fastfetch ;;
	esac
fi
EOF
else
	remove_file "$FF_PROFILE"
fi

# -------------------------------------------- old and small machines --

LOWMEM_HOOK=config/hooks/normal/0991-lowmem.hook.chroot
GRUB_DROPIN=config/includes.chroot_after_packages/etc/default/grub.d/99-cbpp.cfg

# The installed system's kernel command line.
#
# /etc/default/grub is a grub2-common conffile, and grub2-common is installed
# by the installer rather than being in this chroot - so anything written there
# now would be replaced. grub-mkconfig sources /etc/default/grub.d/*.cfg after
# it, which is ours and survives.
if [ "$CBPP_MITIGATIONS" = "off" ]; then
	write_file "$GRUB_DROPIN" 644 <<EOF
# $GEN
#
# See CBPP_MITIGATIONS in cbpp.conf: this trades Spectre and Meltdown hardening
# for the 10-30% those software mitigations cost a CPU with no hardware ones.
GRUB_CMDLINE_LINUX_DEFAULT="\${GRUB_CMDLINE_LINUX_DEFAULT} mitigations=off"
EOF
else
	remove_file "$GRUB_DROPIN"
fi

_trim_any=false
[ "$CBPP_TRIM_INDEXERS" = "true" ] && _trim_any=true
[ "$CBPP_COMPOSITOR" = "false" ] && _trim_any=true
[ "$CBPP_THUNAR_DAEMON" = "false" ] && _trim_any=true
[ "$CBPP_SCREENSAVER" != "xscreensaver" ] && _trim_any=true

if $_trim_any; then
	write_file "$LOWMEM_HOOK" 755 <<EOF
#!/bin/sh
# $GEN
#
# The low-memory profile: what comes out on a machine with 2 GB and a 2009 GPU.
set -e

TRIM_INDEXERS="${CBPP_TRIM_INDEXERS}"
COMPOSITOR="${CBPP_COMPOSITOR}"
THUNAR_DAEMON="${CBPP_THUNAR_DAEMON}"
SCREENSAVER="${CBPP_SCREENSAVER}"

purge() {
	_list=""
	for _p in "\$@"; do
		if dpkg -l "\$_p" 2>/dev/null | grep -q "^ii"; then
			_list="\$_list \$_p"
		fi
	done

	[ -n "\$_list" ] || return 0
	DEBIAN_FRONTEND=noninteractive apt-get -y purge \$_list
	echo "I: purged\$_list"
}

# --- background indexers ---------------------------------------------------
#
# update-apt-xapian-index peaks over 300 MB and runs weekly; on 2 GB that is a
# swap storm, and nothing but synaptic's quick search reads what it builds.
# plocate walks the whole filesystem daily. live-build's own 5010 and 5030
# hooks build these indices later in the build, but both test for the command
# first, so removing the packages here just makes them no-ops.
if [ "\$TRIM_INDEXERS" = "true" ]; then
	purge apt-xapian-index plocate mlocate

	# man pages stay; only the index rebuild goes.
	rm -f /etc/cron.daily/man-db
	if [ -e /usr/lib/systemd/system/man-db.timer ]; then
		ln -sf /dev/null /etc/systemd/system/man-db.timer
		echo "I: masked man-db.timer"
	fi
fi

# --- the screen locker -----------------------------------------------------
#
# xscreensaver is resident for the whole session. i3lock only exists while the
# screen is locked, and X blanks the screen by itself, so the Lock Screen
# entries move over and the Screensaver settings entry goes - it would
# configure a program that is no longer there.
if [ "\$SCREENSAVER" != "xscreensaver" ]; then
	purge xscreensaver xscreensaver-data

	for F in /etc/skel/.config/openbox/rc.xml /etc/skel/.config/openbox/menu.xml \\
		/root/.config/openbox/rc.xml /root/.config/openbox/menu.xml
	do
		[ -f "\$F" ] || continue

		if [ "\$SCREENSAVER" = "i3lock" ]; then
			sed -i 's|xscreensaver-command -lock|i3lock -c 000000|g' "\$F"
		fi

		# Drop the "Screensaver" item, which is five lines around
		# xscreensaver-demo.
		awk '
			/<item label="Screensaver">/ { skip = 1 }
			!skip { print }
			skip && /<\\/item>/ { skip = 0 }
		' "\$F" >"\$F.new"
		mv "\$F.new" "\$F"

		if command -v xmllint >/dev/null 2>&1; then
			xmllint --noout "\$F" ||
				{ echo "E: \$F is not well-formed after editing" >&2; exit 1; }
		fi
	done

	rm -f /etc/skel/.xscreensaver
	echo "I: screen locking is now \$SCREENSAVER"
fi

# --- the autostart ---------------------------------------------------------
for AS in /etc/skel/.config/openbox/autostart /root/.config/openbox/autostart
do
	[ -f "\$AS" ] || continue

	if [ "\$COMPOSITOR" = "false" ]; then
		sed -i 's|^cbpp-compositor --start|#cbpp-compositor --start|' "\$AS"
	fi

	if [ "\$THUNAR_DAEMON" = "false" ]; then
		sed -i 's|^thunar --daemon|#thunar --daemon|' "\$AS"
	fi

	if [ "\$SCREENSAVER" != "xscreensaver" ]; then
		sed -i 's|^xscreensaver -no-splash|#xscreensaver -no-splash|' "\$AS"

		# X blanks the screen on its own; DPMS powers the backlight down
		# afterwards. Neither costs a resident process.
		if ! grep -q "cbpp: screen blanking" "\$AS"; then
			cat >>"\$AS" <<'BLANK'

## Screen blanking without a daemon (cbpp: screen blanking)
xset s 600 &
xset dpms 0 0 900 &
BLANK
		fi
	fi

	echo "I: trimmed \$AS"
done
EOF
else
	remove_file "$LOWMEM_HOOK"
fi

# ------------------------------------------------------- display manager --

DM_HOOK=config/hooks/normal/0993-display-manager.hook.chroot
DM_LIVE=config/includes.chroot_after_packages/usr/lib/live/config/0115-emptty
DM_MOTD=config/includes.chroot_after_packages/usr/share/cbpp/emptty-motd

if [ "$CBPP_DISPLAY_MANAGER" = "emptty" ]; then
	# The login banner. emptty prints this file verbatim and resolves the
	# \x1b escapes itself, so it is generated with no shell quoting at all -
	# a banner full of backslashes inside a nested heredoc is a mistake
	# waiting to happen.
	write_file "$DM_MOTD" 644 <<'EOF'
\x1b[31m  ___ ___  ___   _ _____ ___   _   _  _\x1b[0m
\x1b[31m / __| _ \/ _ \ /_\_   _/ _ \ /_\ | \| |\x1b[0m
\x1b[31m| (__|   / (_) / _ \| || (_) / _ \| .` |\x1b[0m
\x1b[31m \___|_|_\\___/_/ \_\_| \___/_/ \_\_|\_|\x1b[0m

EOF

	# emptty's unit is a template and the instance name is the console, so
	# both the unit to enable and the config file it reads carry the tty in
	# their name. Writing them from the hook keeps CBPP_DM_TTY in one place
	# instead of encoding it into an include path.
	write_file "$DM_HOOK" 755 <<EOF
#!/bin/sh
# $GEN
#
# Put emptty on ${CBPP_DM_TTY} and take lxdm out.
#
# lxdm starts a second X server, draws a login box in GTK2, and throws the
# whole thing away the moment you log in. emptty is one Go binary on a virtual
# console, linked against libc, libpam and libx11, that starts your X server
# directly.
set -e

command -v emptty >/dev/null 2>&1 ||
	{ echo "E: emptty is not installed" >&2; exit 1; }

mkdir -p /etc/emptty

cat >/etc/emptty/conf-${CBPP_DM_TTY} <<'CONF'
# $GEN
#
# TTY_NUMBER is deliberately absent: the systemd unit passes it on the command
# line, and this file is named after it.
SWITCH_TTY=true
PRINT_ISSUE=false
PRINT_MOTD=true
MOTD_PATH=/etc/emptty/motd
DEFAULT_SESSION=${CBPP_DM_SESSION}
DEFAULT_SESSION_ENV=xorg
AUTO_SELECTION=true
SELECT_LAST_USER=global
FG_COLOR=WHITE
BG_COLOR=BLACK
DBUS_LAUNCH=true
LOGGING=rotate
CONF

# The shipped motd is a symlink to a Debian-branded banner under /usr/share.
rm -f /etc/emptty/motd
cp /usr/share/cbpp/emptty-motd /etc/emptty/motd

# The symlink is written directly rather than through "systemctl enable":
# systemd refuses some operations inside a chroot, and this is exactly what
# enabling a WantedBy=multi-user.target template amounts to. cbpp-apt-setup in
# this tree is wired up the same way.
UNIT=/usr/lib/systemd/system/emptty@.service
[ -f "\$UNIT" ] || { echo "E: \$UNIT is missing" >&2; exit 1; }

mkdir -p /etc/systemd/system/multi-user.target.wants
ln -sf "\$UNIT" /etc/systemd/system/multi-user.target.wants/emptty@${CBPP_DM_TTY}.service

# lxdm came from the package list and cbpp-lxdm-theme from cbpp-metapackage's
# Recommends. Neither has anything left to do, and a second display manager
# competing for a console is worse than dead weight.
PURGE=""
for P in lxdm cbpp-lxdm-theme; do
	if dpkg -l "\$P" 2>/dev/null | grep -q "^ii"; then
		PURGE="\$PURGE \$P"
	fi
done

if [ -n "\$PURGE" ]; then
	systemctl disable lxdm.service >/dev/null 2>&1 || true
	DEBIAN_FRONTEND=noninteractive apt-get -y purge \$PURGE
	DEBIAN_FRONTEND=noninteractive apt-get -y autoremove --purge
	echo "I: purged\$PURGE"
fi

# lxdm's postinst points this at itself; nothing should now.
rm -f /etc/systemd/system/display-manager.service

echo "I: emptty is the display manager on ${CBPP_DM_TTY}"
EOF

	# live-config decides autologin for the live session, and it has
	# components for gdm3, lightdm, lxdm, nodm, sddm and slim - but not for
	# emptty. Without this the ISO would boot to a login prompt.
	write_file "$DM_LIVE" 755 <<'EOF'
#!/bin/sh

. /usr/lib/live/config.sh

## GENERATED by scripts/cbpp-apply from cbpp.conf - do not edit by hand.
##
## Autologin for emptty in the live session, modelled on live-config's own
## 0110-lxdm component.

Cmdline ()
{
	for _PARAMETER in ${LIVE_CONFIG_CMDLINE}
	do
		case "${_PARAMETER}" in
			live-config.noautologin|noautologin)
				LIVE_CONFIG_NOAUTOLOGIN="true"
				;;

			live-config.nox11autologin|nox11autologin)
				LIVE_CONFIG_NOX11AUTOLOGIN="true"
				;;

			live-config.username=*|username=*)
				LIVE_USERNAME="${_PARAMETER#*username=}"
				;;
		esac
	done
}

Init ()
{
	case "${LIVE_CONFIG_NOAUTOLOGIN}" in
		true)
			exit 0
			;;
	esac

	case "${LIVE_CONFIG_NOX11AUTOLOGIN}" in
		true)
			exit 0
			;;
	esac

	if ! pkg_is_installed "emptty" || component_was_executed "emptty"
	then
		exit 0
	fi

	echo -n " emptty"
}

Config ()
{
	# emptty will not log anyone in without a password unless they are in
	# nopasswdlogin - the same group gdm3 uses for this.
	if ! getent group nopasswdlogin >/dev/null
	then
		addgroup --system nopasswdlogin >/dev/null 2>&1 || true
	fi

	adduser "${LIVE_USERNAME}" nopasswdlogin >/dev/null 2>&1 || true

	# One config file per console, named after the console.
	for _CONF in /etc/emptty/conf-*
	do
		[ -e "${_CONF}" ] || continue

		sed -i -e "/^AUTOLOGIN=/d" -e "/^DEFAULT_USER=/d" "${_CONF}"
		printf 'AUTOLOGIN=true\nDEFAULT_USER=%s\n' "${LIVE_USERNAME}" \
			>>"${_CONF}"
	done

	# Avoid xinit
	touch /var/lib/live/config/xinit

	# Creating state file
	touch /var/lib/live/config/emptty
}

Cmdline
Init
Config
EOF
else
	remove_file "$DM_HOOK"
	remove_file "$DM_LIVE"
	remove_file "$DM_MOTD"
fi

# ---------------------------------------------------------------- terminal --

TERM_HOOK=config/hooks/normal/0999-terminal.hook.chroot
TERM_BASHRC=config/includes.chroot_after_packages/usr/share/cbpp/bashrc

if [ "$CBPP_TERMINAL_STYLE" = "true" ]; then
	# Slots 0, 1 and 7 of terminator's palette are what "black", "red" and
	# "white" mean inside the terminal, which is how the prompt below gets the
	# accent colour without knowing its hex.
	_palette="${CBPP_TERM_BG}:${CBPP_TERM_ACCENT}:#4e9a06:#c4a000:#3465a4"
	_palette="${_palette}:#75507b:#06989a:${CBPP_TERM_FG}:#555753:#ef2929"
	_palette="${_palette}:#8ae234:#fce94f:#729fcf:#ad7fa8:#34e2e2:#eeeeec"

	write_file "$TERM_BASHRC" 644 <<EOF
# $GEN
#
# Sourced from the end of /etc/skel/.bashrc, which comes from the bash package
# rather than from cbpp-configs - so a hook appends one line to it instead of
# this image shipping a whole copy of Debian's bashrc and owning it forever.
#
# The colour is ANSI 31, not a hex value, because the same prompt has to work
# on the virtual consoles. Terminal-side, slot 1 of the terminator palette is
# CBPP_TERM_ACCENT, so the two agree.

case "\$-" in
*i*) ;;
*) return ;;
esac

case "\$TERM" in
dumb) return ;;
esac

if [ "\$(id -u)" -eq 0 ]; then
	PS1='\[\033[1;31m\]\u@\h\[\033[0m\]:\[\033[1;37m\]\w\[\033[0m\]# '
else
	PS1='\[\033[0;31m\]\u@\h\[\033[0m\]:\[\033[0;37m\]\w\[\033[0m\]\$ '
fi

# Debian's bashrc leaves these off, and they are the two that make ls and grep
# legible against a black background.
alias ls='ls --color=auto'
alias grep='grep --color=auto'
EOF

	write_file "$TERM_HOOK" 755 <<EOF
#!/bin/sh
# $GEN
#
# Black background, grey text, red prompt, and a window border that shows which
# window has the focus.
set -e

# --- terminator ------------------------------------------------------------
for CFG in /etc/skel/.config/terminator/config /root/.config/terminator/config
do
	[ -f "\$CFG" ] || continue

	sed -i 's|^ *background_color *=.*|    background_color = "${CBPP_TERM_BG}"|' "\$CFG"
	sed -i 's|^ *foreground_color *=.*|    foreground_color = "${CBPP_TERM_FG}"|' "\$CFG"
	sed -i 's|^ *background_darkness *=.*|    background_darkness = ${CBPP_TERM_OPACITY}|' "\$CFG"
	sed -i 's|^ *cursor_color *=.*|    cursor_color = "${CBPP_TERM_ACCENT}"|' "\$CFG"
	sed -i 's|^ *palette *=.*|    palette = "${_palette}"|' "\$CFG"

	echo "I: restyled \$CFG"
done

# --- the prompt ------------------------------------------------------------
for RC in /etc/skel/.bashrc /root/.bashrc
do
	[ -f "\$RC" ] || continue
	grep -q "/usr/share/cbpp/bashrc" "\$RC" && continue

	printf '\n# ${BRAND} colours: black background, grey text, red prompt.\n. /usr/share/cbpp/bashrc\n' >>"\$RC"
	echo "I: hooked the prompt into \$RC"
done

# --- the root window -------------------------------------------------------
#
# The Openbox autostart paints the root window a solid CBPP grey before
# nitrogen restores the wallpaper over it, so every login opens with a grey
# flash. Painting it the wallpaper's own backdrop colour removes the flash and
# is also what shows through nitrogen's letterboxing afterwards.
for AS in /etc/skel/.config/openbox/autostart /root/.config/openbox/autostart
do
	[ -f "\$AS" ] || continue

	sed -i 's|hsetroot -solid "[^"]*"|hsetroot -solid "${CBPP_WALLPAPER_BGCOLOR}"|' "\$AS"
done

# --- window borders --------------------------------------------------------
#
# The stock CBPP theme paints one light grey border on active and inactive
# windows alike, so there is no visual cue for focus at all. Rather than fork
# cbpp-ui-theme, derive a theme from it here and repoint rc.xml.
BORDER="${CBPP_TERM_BORDER}"
SRC=/usr/share/themes/CBPP/openbox-3
DST=/usr/share/themes/${BRAND}/openbox-3

if [ "\$BORDER" != "true" ]; then
	echo "I: leaving the window borders as CBPP ships them"
	exit 0
fi

if [ -d "\$SRC" ]; then
	mkdir -p "\$DST"
	cp -a "\$SRC"/. "\$DST"/

	sed -i 's|^border.color:.*|border.color: #1c1c1c|' "\$DST/themerc"
	grep -q "^window.active.border.color" "\$DST/themerc" ||
		printf 'window.active.border.color: %s\nwindow.inactive.border.color: %s\n' \\
			"${CBPP_TERM_ACCENT}" "#2b2b2b" >>"\$DST/themerc"

	for RC in /etc/skel/.config/openbox/rc.xml /root/.config/openbox/rc.xml
	do
		[ -f "\$RC" ] || continue

		sed -i '/<theme>/,/<\\/theme>/ s|<name>CBPP</name>|<name>${BRAND}</name>|' "\$RC"

		if command -v xmllint >/dev/null 2>&1; then
			xmllint --noout "\$RC" ||
				{ echo "E: \$RC is not well-formed after editing" >&2; exit 1; }
		fi
	done

	echo "I: window borders now mark the focused window"
else
	echo "W: /usr/share/themes/CBPP is not there, leaving the borders alone" >&2
fi
EOF
else
	remove_file "$TERM_HOOK"
	remove_file "$TERM_BASHRC"
fi

# ---------------------------------------------------------------- keyboard --

KBD_HOOK=config/hooks/normal/0994-keyboard.hook.chroot
KBD_XORG=config/includes.chroot_after_packages/etc/X11/xorg.conf.d/99-cbpp-keyboard.conf
KBD_BIN=config/includes.chroot_after_packages/usr/bin/cbpp-kblayout

if [ -n "$CBPP_KEYBOARD_LAYOUTS" ]; then
	write_file "$KBD_XORG" 644 <<EOF
# $GEN
#
# Layout switching in the X server itself. No input-method framework, no
# daemon, and it works before anything in the session has started.
Section "InputClass"
	Identifier "cbpp keyboard layout"
	MatchIsKeyboard "on"
	Option "XkbLayout" "${CBPP_KEYBOARD_LAYOUTS}"
	Option "XkbOptions" "${CBPP_KEYBOARD_TOGGLE}"
EndSection
EOF

	write_file "$KBD_BIN" 755 <<EOF
#!/bin/sh
# $GEN
#
# Print the active keyboard layout, for the tint2 indicator.
#
# X has no command that simply reports the active XKB group. It is mirrored
# into the keyboard LED mask, which xset does print - groups 2, 3 and 4 light
# bits 12, 13 and 14 - and that is what every shell indicator ends up reading.
#
# The layout list is baked in rather than read back from setxkbmap so that this
# costs one process per tick instead of two; it comes from the same
# CBPP_KEYBOARD_LAYOUTS that wrote the Xorg snippet.
set -eu

LAYOUTS="${CBPP_KEYBOARD_LAYOUTS}"

MASK=\$(xset -q 2>/dev/null | awk '/LED mask/ { print \$NF }')
case "\$MASK" in
"" | *[!0-9A-Fa-f]*) MASK=0 ;;
esac

BITS=\$((0x\$MASK))

if [ \$((BITS & 0x4000)) -ne 0 ]; then
	INDEX=4
elif [ \$((BITS & 0x2000)) -ne 0 ]; then
	INDEX=3
elif [ \$((BITS & 0x1000)) -ne 0 ]; then
	INDEX=2
else
	INDEX=1
fi

NAME=\$(printf '%s' "\$LAYOUTS" | cut -d, -f"\$INDEX")
[ -n "\$NAME" ] || NAME=\$(printf '%s' "\$LAYOUTS" | cut -d, -f1)

printf '%s\n' "\$NAME" | tr 'a-z' 'A-Z'
EOF

	write_file "$KBD_HOOK" 755 <<EOF
#!/bin/sh
# $GEN
#
# Take out ibus and put the layout indicator in the panel instead.
set -e

# --- ibus ------------------------------------------------------------------
#
# ibus arrives as a Recommends of cbpp-metapackage and is launched by
# im-config's Xsession script. It is a whole input-method framework - GTK3,
# dconf, python3 and a resident daemon - whose only visible contribution here
# is naming the layout, and it cannot even switch, because only "us" was ever
# configured. Nothing in cbpp-metapackage depends on it, so it can go.
PURGE=""
for P in ibus im-config; do
	if dpkg -l "\$P" 2>/dev/null | grep -q "^ii"; then
		PURGE="\$PURGE \$P"
	fi
done

if [ -n "\$PURGE" ]; then
	DEBIAN_FRONTEND=noninteractive apt-get -y purge \$PURGE
	DEBIAN_FRONTEND=noninteractive apt-get -y autoremove --purge
	echo "I: purged\$PURGE"
fi

# --- the console -----------------------------------------------------------
if [ -f /etc/default/keyboard ]; then
	sed -i 's|^XKBLAYOUT=.*|XKBLAYOUT="${CBPP_KEYBOARD_LAYOUTS}"|' /etc/default/keyboard
	sed -i 's|^XKBOPTIONS=.*|XKBOPTIONS="${CBPP_KEYBOARD_TOGGLE}"|' /etc/default/keyboard
fi

# --- the indicator ---------------------------------------------------------
INDICATOR="${CBPP_KEYBOARD_INDICATOR}"
TINT2=/etc/skel/.config/tint2/tint2rc

if [ "\$INDICATOR" != "true" ]; then
	echo "I: no layout indicator was asked for"
	exit 0
fi

if [ ! -f "\$TINT2" ]; then
	echo "W: \$TINT2 is not there, skipping the layout indicator" >&2
	exit 0
fi

if grep -q "cbpp-kblayout" "\$TINT2"; then
	echo "I: the layout indicator is already in the panel"
	exit 0
fi

# tint2 pairs the Nth E in panel_items with the Nth execp block, so the block
# can simply go at the end of the file. E before C puts it left of the clock.
grep -q "^panel_items = TSC\$" "\$TINT2" ||
	{ echo "E: unexpected panel_items in \$TINT2" >&2; exit 1; }

sed -i 's|^panel_items = TSC\$|panel_items = TSEC|' "\$TINT2"

cat >>"\$TINT2" <<'PANEL'

# Keyboard layout
execp = new
execp_command = cbpp-kblayout
execp_interval = 1
execp_has_icon = 0
execp_continuous = 0
execp_markup = 0
execp_font = Liberation Sans Bold 10
execp_font_color = ${CBPP_TERM_ACCENT} 100
execp_padding = 8 4
execp_background_id = 0
execp_centered = 1
execp_tooltip = Keyboard layout
execp_lclick_command = xdotool key --clearmodifiers alt+shift
PANEL

echo "I: added the layout indicator to the panel"
EOF
else
	remove_file "$KBD_HOOK"
	remove_file "$KBD_XORG"
	remove_file "$KBD_BIN"
fi

# ---------------------------------------------------------------- branding --

BRAND_HOOK=config/hooks/normal/0992-branding.hook.chroot

# The grub menu's own title line. live-build only rewrites this when it falls
# back to its stock splash, which it does not here, so whatever is on disk is
# what boots.
BRAND_THEME=config/bootloaders/grub-pc/live-theme/theme.txt
if [ -n "$CBPP_BRANDING" ] && [ -f "$BRAND_THEME" ]; then
	awk -v t="${BRAND} ${CBPP_VERSION}" '
		index($0, "title-text:") == 1 { print "title-text: \"" t "\""; next }
		{ print }
	' "$BRAND_THEME" >"$BRAND_THEME.cbpp-tmp"
	commit_tmp "$BRAND_THEME" "title-text: ${BRAND} ${CBPP_VERSION}"
fi

if [ -n "$CBPP_BRANDING" ]; then
	write_file "$BRAND_HOOK" 755 <<EOF
#!/bin/sh
# $GEN
#
# Rename #!++ to ${BRAND} everywhere this image can reach it.
#
# Most of the old name is inside other people's packages, so this runs after
# they are installed and rewrites what they wrote. What it cannot reach:
# strings compiled into debian-installer's own udebs, and the artwork in
# cbpp-wallpapers.
set -e

# --- what the system calls itself ------------------------------------------
#
# ID stays "debian" on purpose: scripts and third-party installers branch on
# it, and lying there breaks them for no gain.
OSR=/usr/lib/os-release
[ -f "\$OSR" ] || OSR=/etc/os-release

if [ -f "\$OSR" ]; then
	sed -i \\
		-e 's|^NAME=.*|NAME="${BRAND}"|' \\
		-e 's|^PRETTY_NAME=.*|PRETTY_NAME="${BRAND} ${CBPP_VERSION}"|' \\
		"\$OSR"
	echo "I: \$OSR now says ${BRAND}"
fi

# Written whole rather than sed'ed: the escapes getty expands here (\n for the
# hostname, \l for the line) would be eaten by sed's own replacement syntax.
cat >/etc/issue <<'ISSUE'
${BRAND} ${CBPP_VERSION} \n \l

ISSUE

printf '%s\n' "${BRAND} ${CBPP_VERSION}" >/etc/issue.net

# --- the welcome script ----------------------------------------------------
if [ -d /usr/lib/lib-cbpp-welcome ]; then
	grep -rl "CrunchBangPlusPlus" /usr/lib/lib-cbpp-welcome 2>/dev/null |
		while read -r F; do
			sed -i 's|CrunchBangPlusPlus|${BRAND}|g' "\$F"
		done
	echo "I: rebranded the welcome script"
fi

# --- the root menu ---------------------------------------------------------
for RC in /etc/skel/.config/openbox/menu.xml /root/.config/openbox/menu.xml
do
	[ -f "\$RC" ] || continue
	sed -i 's|<menu id="root-menu" label="[^"]*">|<menu id="root-menu" label="${BRAND}">|' "\$RC"

	if command -v xmllint >/dev/null 2>&1; then
		xmllint --noout "\$RC" ||
			{ echo "E: \$RC is not well-formed after editing" >&2; exit 1; }
	fi
done
EOF
else
	remove_file "$BRAND_HOOK"
fi

# ----------------------------------------------------- generated packages --

GEN_PKGS=""
add_pkg() { GEN_PKGS="${GEN_PKGS}${GEN_PKGS:+
}$1"; }

# The display manager used to be hardcoded in live.list.chroot, which meant
# changing it took an edit in two places that could disagree.
add_pkg "$CBPP_DISPLAY_MANAGER"

# VA-API. vainfo comes too: without it there is no way to tell whether hardware
# decoding is actually working, and on a GPU this old that is the first
# question anyone asks.
case $CBPP_HWVIDEO in
i965)
	add_pkg i965-va-driver
	add_pkg vainfo
	;;
iHD)
	add_pkg intel-media-va-driver
	add_pkg vainfo
	;;
esac

[ "$CBPP_SCREENSAVER" = "i3lock" ] && add_pkg i3lock

[ "$CBPP_ZRAM" = "true" ] && add_pkg systemd-zram-generator
[ "$CBPP_EARLYOOM" = "true" ] && add_pkg earlyoom
[ "$CBPP_FASTFETCH" = "true" ] && add_pkg fastfetch

# cbpp-metapackage recommends "ntp", which trixie no longer has, so the image
# ends up with no clock synchronisation at all.
[ "$CBPP_TIMESYNC" = "true" ] && add_pkg systemd-timesyncd
[ -n "$CBPP_CLIPBOARD" ] && add_pkg "$CBPP_CLIPBOARD"

# scrot and notify-send already arrive through cbpp-metapackage's Recommends,
# but naming them here means the screenshot entry cannot quietly stop working
# if that list changes. libxml2-utils gives the menu and keybinding hooks an
# xmllint to check their edits with - a malformed rc.xml breaks the desktop,
# and a build failure is a much better way to find that out.
if [ "$CBPP_SCREENSHOT" = "true" ]; then
	add_pkg scrot
	add_pkg libnotify-bin
fi
if [ "$CBPP_SCREENSHOT" = "true" ] || [ "$CBPP_KEYBINDS" = "true" ] ||
	[ -n "$CBPP_BRANDING" ] || [ "$CBPP_TERM_BORDER" = "true" ]; then
	add_pkg libxml2-utils
fi

# The indicator's click-to-switch shoots an Alt+Shift at the X server. xdotool
# is already a cbpp-metapackage recommendation; naming it means the indicator
# cannot quietly lose that half of itself if the list changes.
if [ -n "$CBPP_KEYBOARD_LAYOUTS" ] && [ "$CBPP_KEYBOARD_INDICATOR" = "true" ]; then
	add_pkg xdotool
fi

if [ -n "$GEN_PKGS" ]; then
	write_file "$GEN_PKG_LIST" 644 <<EOF
# $GEN
$GEN_PKGS
EOF
else
	remove_file "$GEN_PKG_LIST"
fi

# ------------------------------------------------ apt sources in the image --

write_file config/includes.chroot_after_packages/usr/lib/cbpp/apt-setup 755 <<EOF
#!/bin/bash -ex
# $GEN

if [[ -f /etc/apt/sources.list ]] && [[ ! -f /etc/apt/sources.list.d/debian.sources ]]; then
cat << SOURCES > /etc/apt/sources.list.d/debian.sources
# Add 'deb-src' to Types line for source packages
Types: deb
URIs: ${CBPP_MIRROR}
Suites: ${CBPP_DISTRIBUTION} ${CBPP_DISTRIBUTION}-updates ${CBPP_DISTRIBUTION}-backports
Components: main contrib non-free non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg

Types: deb
URIs: http://security.debian.org/debian-security/
Suites: ${CBPP_DISTRIBUTION}-security
Components: main contrib non-free non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
SOURCES
rm -f /etc/apt/sources.list
rm -f /etc/apt/sources.list~
fi

systemctl disable cbpp-apt-setup
rm -f /usr/lib/systemd/system/cbpp-apt-setup.service
rm -rf /usr/lib/cbpp
EOF

# -------------------------------------------------------------------------- --

if [ "$CHANGED" -eq 0 ]; then
	$QUIET || echo "cbpp-apply: config/ already matches cbpp.conf"
	exit 0
fi

if $CHECK; then
	echo "cbpp-apply: config/ is out of sync with cbpp.conf ($CHANGED item(s)) - run 'make apply'" >&2
	exit 1
fi

$QUIET || echo "cbpp-apply: updated $CHANGED item(s)"
