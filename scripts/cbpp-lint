#!/bin/sh
# cbpp-lint - static checks on the live-build tree, run before a build.
#
# Everything here is a mistake that otherwise only shows up 30 minutes into a
# build, or worse, in a silently broken ISO.

set -eu

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$ROOT"

FAIL=0

fail() { echo "FAIL  $*" >&2; FAIL=$((FAIL + 1)); }
warn() { echo "warn  $*" >&2; }
ok() { echo "ok    $*"; }

# shellcheck disable=SC1091
. ./cbpp.conf

# -- config/ must match cbpp.conf -------------------------------------------

if scripts/cbpp-apply --check --quiet >/dev/null 2>&1; then
	ok "config/ is in sync with cbpp.conf"
else
	fail "config/ has drifted from cbpp.conf - run 'make apply'"
fi

# -- the both-directories-non-empty hook gate -------------------------------
#
# live-build's chroot_hooks only enters its loop when config/hooks/normal has a
# *.chroot AND config/hooks/live has a *.chroot or *.container.  Empty either
# one and every hook is skipped without a word of warning.

_normal=$(find config/hooks/normal -maxdepth 1 -name '*.chroot' 2>/dev/null | wc -l)
_live=$(find config/hooks/live -maxdepth 1 \( -name '*.chroot' -o -name '*.container' \) 2>/dev/null | wc -l)

if [ "$_normal" -gt 0 ] && [ "$_live" -gt 0 ]; then
	ok "hook directories non-empty (normal=$_normal live=$_live)"
else
	fail "config/hooks/normal ($_normal) and config/hooks/live ($_live) must BOTH be non-empty, or live-build runs no hooks at all"
fi

# -- hooks are executable and parse -----------------------------------------

for _hook in $(find config/hooks -name '*.hook.*' -type f 2>/dev/null | sort); do
	[ -x "$_hook" ] || fail "$_hook is not executable"
	case $(head -n1 "$_hook") in
	*bash*) bash -n "$_hook" 2>/dev/null || fail "$_hook: bash syntax error" ;;
	*sh*) sh -n "$_hook" 2>/dev/null || fail "$_hook: sh syntax error" ;;
	*) warn "$_hook: no recognised shebang" ;;
	esac
done
ok "hooks are executable and parse"

# -- kernel package name ----------------------------------------------------
#
# live-build appends "-${LB_LINUX_FLAVOURS_WITH_ARCH}" to each LB_LINUX_PACKAGES
# entry, so a name that already carries the arch produces linux-image-amd64-amd64.

case $CBPP_KERNEL in
*-"$CBPP_ARCH")
	fail "CBPP_KERNEL ('$CBPP_KERNEL') must not end in -$CBPP_ARCH; live-build appends the flavour itself"
	;;
*)
	ok "CBPP_KERNEL resolves to ${CBPP_KERNEL}-${CBPP_ARCH}"
	;;
esac

if [ "$CBPP_KERNEL_BACKPORTS" = "true" ] && [ "$(grep '^LB_BACKPORTS=' config/chroot)" != 'LB_BACKPORTS="true"' ]; then
	fail "CBPP_KERNEL_BACKPORTS is on but LB_BACKPORTS is not true - the backports suite will not be available to the hook"
fi

# -- ISO volume label -------------------------------------------------------
#
# ISO9660 caps the volume id at 32 characters.  live-build expands
# @ISOVOLUME_TS@ into YYYYmmdd-HH:MM (14 chars) at build time, so check the
# expanded length, not the literal.

_vol=$(sed -n 's/^LB_ISO_VOLUME="\(.*\)"$/\1/p' config/binary)
_vol_expanded=$(printf '%s' "$_vol" | sed 's/@ISOVOLUME_TS@/20260101-00:00/')
_len=${#_vol_expanded}
if [ "$_len" -le 32 ]; then
	ok "ISO volume '$_vol' expands to $_len chars (limit 32)"
else
	fail "ISO volume expands to $_len chars, over the 32-char ISO9660 limit: '$_vol_expanded'"
fi

# -- compression choices ----------------------------------------------------

case $CBPP_SQUASHFS_COMPRESSION in
gzip | lzo | lz4 | xz | zstd) ok "squashfs compression '$CBPP_SQUASHFS_COMPRESSION'" ;;
"") warn "CBPP_SQUASHFS_COMPRESSION is empty; live-build defaults to xz" ;;
*) fail "unknown squashfs compression '$CBPP_SQUASHFS_COMPRESSION'" ;;
esac

# live-build validates this one itself and aborts on anything else; it only
# implements gzip (no-op), bzip2 and lzma in chroot_hacks.
case $CBPP_INITRAMFS_COMPRESSION in
gzip | bzip2 | lzma) ok "initramfs compression '$CBPP_INITRAMFS_COMPRESSION'" ;;
*) fail "live-build only accepts gzip, bzip2 or lzma for initramfs compression, not '$CBPP_INITRAMFS_COMPRESSION'" ;;
esac

# -- zram -------------------------------------------------------------------

if [ "$CBPP_ZRAM" = "true" ]; then
	# The kernel rejects an unknown compressor and the zram device then fails to
	# come up, leaving the system with no swap at all.
	case $CBPP_ZRAM_ALGORITHM in
	lzo | lzo-rle | lz4 | lz4hc | 842 | zstd)
		ok "zram algorithm '$CBPP_ZRAM_ALGORITHM'"
		;;
	*)
		fail "unknown zram compression algorithm '$CBPP_ZRAM_ALGORITHM' (lzo, lzo-rle, lz4, lz4hc, 842, zstd)"
		;;
	esac

	grep -qx "systemd-zram-generator" config/package-lists/cbpp-generated.list.chroot 2>/dev/null ||
		fail "CBPP_ZRAM is on but systemd-zram-generator is not in the package list"

	grep -q "^zram-size = ${CBPP_ZRAM_SIZE}\$" \
		config/includes.chroot_after_packages/etc/systemd/zram-generator.conf 2>/dev/null ||
		fail "zram-generator.conf does not carry CBPP_ZRAM_SIZE"

	ok "zram enabled: ${CBPP_ZRAM_SIZE}, priority ${CBPP_ZRAM_PRIORITY}"
else
	ok "zram disabled"
fi

# swappiness above 100 only means anything on kernels since 5.8, and the
# kernel clamps anything above 200.
case $CBPP_VM_SWAPPINESS in
'' | *[!0-9]*) fail "CBPP_VM_SWAPPINESS must be an integer, got '$CBPP_VM_SWAPPINESS'" ;;
*)
	if [ "$CBPP_VM_SWAPPINESS" -le 200 ]; then
		ok "vm.swappiness=$CBPP_VM_SWAPPINESS"
	else
		fail "CBPP_VM_SWAPPINESS is $CBPP_VM_SWAPPINESS; the kernel ceiling is 200"
	fi
	;;
esac

case $CBPP_VM_PAGE_CLUSTER in
'' | *[!0-9]*) fail "CBPP_VM_PAGE_CLUSTER must be an integer, got '$CBPP_VM_PAGE_CLUSTER'" ;;
*) ok "vm.page-cluster=$CBPP_VM_PAGE_CLUSTER" ;;
esac

if [ "$CBPP_EARLYOOM" = "true" ]; then
	grep -qx "earlyoom" config/package-lists/cbpp-generated.list.chroot 2>/dev/null ||
		fail "CBPP_EARLYOOM is on but earlyoom is not in the package list"
	ok "earlyoom enabled"
elif [ "$CBPP_ZRAM" = "true" ]; then
	warn "zram is on without earlyoom; with no disk swap behind it a full zram device can thrash before the kernel OOM killer reacts"
fi

# -- firefox ----------------------------------------------------------------

if [ "$CBPP_FIREFOX_LOWMEM" = "true" ]; then
	_ffp=config/includes.chroot_after_packages/usr/share/firefox-esr/browser/defaults/preferences/zz-cbpp-lowmem.js

	# Firefox reports "prefs parse error" and skips the rest of the file, so a
	# stray line silently drops every pref after it.
	_bad=$(grep -vE '^[[:space:]]*(//|$)' "$_ffp" 2>/dev/null |
		grep -cvE '^pref\("[^"]+", .+\);$' || true)
	if [ "${_bad:-1}" -eq 0 ]; then
		ok "firefox prefs parse ($(grep -c '^pref(' "$_ffp") settings)"
	else
		fail "$_ffp has $_bad line(s) that are not a well-formed pref() call"
	fi

	case $CBPP_FIREFOX_FISSION in
	true) ok "firefox site isolation kept on" ;;
	false) warn "firefox site isolation is OFF - saves the most memory, but drops the boundary that contains Spectre-style attacks between sites" ;;
	*) fail "CBPP_FIREFOX_FISSION must be true or false, got '$CBPP_FIREFOX_FISSION'" ;;
	esac

	case $CBPP_FIREFOX_PROCESS_COUNT in
	'' | *[!0-9]*) fail "CBPP_FIREFOX_PROCESS_COUNT must be an integer, got '$CBPP_FIREFOX_PROCESS_COUNT'" ;;
	0) fail "CBPP_FIREFOX_PROCESS_COUNT must be at least 1" ;;
	*) ok "firefox content processes: $CBPP_FIREFOX_PROCESS_COUNT (default is 8)" ;;
	esac
else
	ok "firefox low-memory defaults disabled"
fi

# -- ipv6 -------------------------------------------------------------------

case $CBPP_IPV6 in
disabled)
	grep -q "^net.ipv6.conf.all.disable_ipv6 = 1$" \
		config/includes.chroot_after_packages/etc/sysctl.d/99-cbpp-ipv6.conf 2>/dev/null ||
		fail "CBPP_IPV6 is disabled but the sysctl drop-in does not disable it"
	warn "IPv6 is disabled - an IPv6-only network (some mobile carriers, DS-Lite ISPs) will have no connectivity at all"
	;;
enabled)
	ok "IPv6 enabled with privacy extensions"
	;;
*)
	fail "CBPP_IPV6 must be 'disabled' or 'enabled', got '$CBPP_IPV6'"
	;;
esac

# -- wallpaper --------------------------------------------------------------

if [ -n "$CBPP_WALLPAPER" ]; then
	_wp="config/includes.chroot_after_packages${CBPP_WALLPAPER}"
	if [ -f "$_wp" ]; then
		ok "wallpaper shipped at ${CBPP_WALLPAPER} ($(( $(wc -c < "$_wp") / 1024 )) KiB)"
	else
		fail "CBPP_WALLPAPER is ${CBPP_WALLPAPER} but no such file under includes.chroot_after_packages"
	fi

	# nitrogen stores the mode as a bare integer and the enum order is fixed on
	# disk; anything outside 0-5 silently gives you a wrong or unset background.
	case $CBPP_WALLPAPER_MODE in
	0 | 1 | 2 | 3 | 4 | 5) ok "wallpaper mode $CBPP_WALLPAPER_MODE" ;;
	*) fail "CBPP_WALLPAPER_MODE must be 0-5 (scale/tile/center/zoom/auto/zoom-fill), got '$CBPP_WALLPAPER_MODE'" ;;
	esac
else
	ok "no default wallpaper set"
fi

# -- fastfetch --------------------------------------------------------------

if [ "$CBPP_FASTFETCH" = "true" ]; then
	grep -qx "fastfetch" config/package-lists/cbpp-generated.list.chroot 2>/dev/null ||
		fail "CBPP_FASTFETCH is on but fastfetch is not in the package list"

	# The config points at an absolute path inside the image; make sure the file
	# behind it is actually shipped, or fastfetch silently draws no logo.
	_ffconf=config/includes.chroot_after_packages/etc/xdg/fastfetch/config.jsonc
	_logo=$(sed -n 's/.*"source": "\(.*\)".*/\1/p' "$_ffconf" 2>/dev/null)
	if [ -n "$_logo" ] && [ -f "config/includes.chroot_after_packages${_logo}" ]; then
		# The shipped logo carries ANSI escapes, so measure the width fastfetch
		# actually lays out with - visible characters, not bytes.
		_lf="config/includes.chroot_after_packages${_logo}"
		_cols=$(sed 's/\x1b\[[0-9;]*m//g' "$_lf" |
			awk '{ if (length > m) m = length } END { print m + 0 }')
		ok "fastfetch logo '${CBPP_LOGO_STYLE}' at ${_logo} ($(wc -l < "$_lf") lines, $_cols visible cols)"
	else
		fail "fastfetch config references '${_logo:-<unset>}' but that file is not in includes.chroot_after_packages"
	fi

	if [ "$CBPP_FASTFETCH_ON_LOGIN" = "true" ]; then
		_ffp=config/includes.chroot_after_packages/etc/profile.d/cbpp-fastfetch.sh
		sh -n "$_ffp" 2>/dev/null || fail "$_ffp: syntax error"
		ok "fastfetch runs on interactive login shells"
	fi
else
	ok "fastfetch disabled"
fi

# -- old and small machines -------------------------------------------------

case $CBPP_HWVIDEO in
"") ;;
i965 | iHD)
	_vadrv=i965-va-driver
	[ "$CBPP_HWVIDEO" = "iHD" ] && _vadrv=intel-media-va-driver
	grep -qx "$_vadrv" config/package-lists/cbpp-generated.list.chroot 2>/dev/null ||
		fail "CBPP_HWVIDEO is '$CBPP_HWVIDEO' but $_vadrv is not in the package list"
	ok "hardware video via $_vadrv"
	;;
*) fail "CBPP_HWVIDEO must be empty, i965 or iHD, got '$CBPP_HWVIDEO'" ;;
esac

if [ "$CBPP_ICON_CACHE" = "true" ]; then
	grep -qx "libgtk-3-bin" config/package-lists/cbpp-generated.list.chroot 2>/dev/null ||
		fail "CBPP_ICON_CACHE is on but libgtk-3-bin, which provides gtk-update-icon-cache, is not in the package list"

	# live-build's stock hook deletes exactly what ours builds, and it runs
	# first. Having both is worse than having neither: the build spends the
	# time and the image still ships no cache.
	#
	# -L as well as -e, because these hooks are symlinks into live-build's own
	# directory and so dangle outside the build container - which is exactly
	# the state this has to catch.
	_stock=config/hooks/normal/9000-remove-gnome-icon-cache.hook.chroot
	if [ -e "$_stock" ] || [ -L "$_stock" ]; then
		fail "9000-remove-gnome-icon-cache is still linked in and will delete the caches 9030 builds"
	fi

	ok "icon and font caches built into the image"
fi

case $CBPP_SCREENSAVER in
xscreensaver | none) ok "screen locking: $CBPP_SCREENSAVER" ;;
i3lock)
	grep -qx "i3lock" config/package-lists/cbpp-generated.list.chroot 2>/dev/null ||
		fail "CBPP_SCREENSAVER is i3lock but i3lock is not in the package list"
	ok "screen locking: i3lock, with X blanking behind it"
	;;
*) fail "CBPP_SCREENSAVER must be xscreensaver, i3lock or none, got '$CBPP_SCREENSAVER'" ;;
esac

case $CBPP_MITIGATIONS in
on) ok "CPU mitigations left on" ;;
off)
	# Two places have to agree, or the live session and the installed system
	# behave differently and nobody notices until they benchmark both.
	grep -q "mitigations=off" config/binary ||
		fail "CBPP_MITIGATIONS is off but the live boot cmdline does not say so"
	[ -f config/includes.chroot_after_packages/etc/default/grub.d/99-cbpp.cfg ] ||
		fail "CBPP_MITIGATIONS is off but the grub drop-in for the installed system is missing"
	warn "CPU mitigations are OFF - Spectre and Meltdown are unmitigated on this image"
	;;
*) fail "CBPP_MITIGATIONS must be on or off, got '$CBPP_MITIGATIONS'" ;;
esac

if [ "$CBPP_FIREFOX_VIDEO" = "h264" ]; then
	_ffp=config/includes.chroot_after_packages/usr/share/firefox-esr/browser/defaults/preferences/zz-cbpp-lowmem.js
	grep -q "media.ffmpeg.vaapi.enabled" "$_ffp" 2>/dev/null ||
		fail "CBPP_FIREFOX_VIDEO is h264 but the vaapi prefs are not in $_ffp"
	[ -n "$CBPP_HWVIDEO" ] ||
		warn "CBPP_FIREFOX_VIDEO forces H.264 but CBPP_HWVIDEO is empty - nothing will decode it in hardware"
	ok "firefox steered onto H.264 with hardware decoding"
elif [ -n "$CBPP_FIREFOX_VIDEO" ]; then
	fail "CBPP_FIREFOX_VIDEO must be empty or h264, got '$CBPP_FIREFOX_VIDEO'"
fi

# -- display manager --------------------------------------------------------

grep -qx "$CBPP_DISPLAY_MANAGER" config/package-lists/cbpp-generated.list.chroot 2>/dev/null ||
	fail "CBPP_DISPLAY_MANAGER is '$CBPP_DISPLAY_MANAGER' but that package is not in the generated list"

# lxdm used to be pinned in live.list.chroot. Leaving it there while emptty is
# selected installs both, and whichever grabs a console first wins.
if grep -qx "lxdm" config/package-lists/live.list.chroot 2>/dev/null &&
	[ "$CBPP_DISPLAY_MANAGER" != "lxdm" ]; then
	fail "live.list.chroot still pins lxdm while CBPP_DISPLAY_MANAGER is '$CBPP_DISPLAY_MANAGER'"
fi

if [ "$CBPP_DISPLAY_MANAGER" = "emptty" ]; then
	case $CBPP_DM_TTY in
	tty[1-9] | tty1[0-9])
		# The unit conflicts with getty@%i, and gettys live on tty1-6.
		case $CBPP_DM_TTY in
		tty[1-6]) warn "CBPP_DM_TTY=$CBPP_DM_TTY displaces a getty; tty7 and up are free" ;;
		esac
		;;
	*) fail "CBPP_DM_TTY must be a console name like tty7, got '$CBPP_DM_TTY'" ;;
	esac

	# Without this component the live session stops at a login prompt, which
	# is the kind of thing only a boot reveals.
	_lcomp=config/includes.chroot_after_packages/usr/lib/live/config/0115-emptty
	if [ -x "$_lcomp" ]; then
		ok "emptty on $CBPP_DM_TTY, with live-session autologin"
	else
		fail "$_lcomp is missing or not executable - the live session would not log in"
	fi
fi

# -- terminal ---------------------------------------------------------------

if [ "$CBPP_TERMINAL_STYLE" = "true" ]; then
	for _c in "$CBPP_TERM_BG" "$CBPP_TERM_FG" "$CBPP_TERM_ACCENT"; do
		case $_c in
		"#"[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) ;;
		*) fail "terminal colour '$_c' is not a #rrggbb value" ;;
		esac
	done

	# terminator reads this as a float; anything outside 0..1 is silently
	# clamped and the window comes out looking nothing like the setting.
	case $CBPP_TERM_OPACITY in
	0 | 1 | 0.[0-9] | 0.[0-9][0-9] | 1.0 | 1.00) ;;
	*) fail "CBPP_TERM_OPACITY must be between 0 and 1, got '$CBPP_TERM_OPACITY'" ;;
	esac

	ok "terminal ${CBPP_TERM_FG} on ${CBPP_TERM_BG} at ${CBPP_TERM_OPACITY}, accent ${CBPP_TERM_ACCENT}"
fi

# -- keyboard ---------------------------------------------------------------

if [ -n "$CBPP_KEYBOARD_LAYOUTS" ]; then
	case $CBPP_KEYBOARD_LAYOUTS in
	*[!a-z,]*) fail "CBPP_KEYBOARD_LAYOUTS must be comma-separated XKB names, got '$CBPP_KEYBOARD_LAYOUTS'" ;;
	esac

	# More than four layouts cannot be told apart: XKB only mirrors groups
	# 2-4 into the LED mask, which is all the indicator has to read.
	_nlayouts=$(printf '%s' "$CBPP_KEYBOARD_LAYOUTS" | tr ',' '\n' | grep -c .)
	[ "$_nlayouts" -le 4 ] ||
		fail "XKB supports at most 4 groups, CBPP_KEYBOARD_LAYOUTS has $_nlayouts"

	[ -n "$CBPP_KEYBOARD_TOGGLE" ] ||
		warn "CBPP_KEYBOARD_LAYOUTS is set but CBPP_KEYBOARD_TOGGLE is empty - nothing switches them"

	ok "keyboard layouts $CBPP_KEYBOARD_LAYOUTS via $CBPP_KEYBOARD_TOGGLE"
fi

# -- branding ---------------------------------------------------------------

if [ -n "$CBPP_BRANDING" ]; then
	grep -q "hostname=${CBPP_HOSTNAME}\( \|\"\)" config/binary ||
		fail "config/binary: live hostname does not match CBPP_HOSTNAME='$CBPP_HOSTNAME'"

	# The boot splash is rendered from splash.svg at build time, per
	# bootloader - so a name left in one of them is the first thing a user
	# sees, and it is invisible in any diff of the PNGs.
	for _svg in config/bootloaders/*/splash.svg; do
		[ -e "$_svg" ] || continue
		grep -q "CrunchBang" "$_svg" &&
			fail "$_svg still says CrunchBang - re-run assets/make-branding.py"

		# A splash.png beside a splash.svg wins silently: live-build skips
		# rsvg-convert when one is already there. That is exactly how the
		# BIOS boot menu kept the old logo while the EFI one changed.
		if [ -e "${_svg%.svg}.png" ]; then
			fail "${_svg%.svg}.png shadows $_svg - live-build will not render the SVG"
		fi
	done
	grep -q "^title-text: \"${CBPP_BRANDING}" \
		config/bootloaders/grub-pc/live-theme/theme.txt 2>/dev/null ||
		warn "config/bootloaders/grub-pc/live-theme/theme.txt: grub menu title is not branded"

	# The ISO volume label is a Joliet field: 32 characters, and live-build
	# expands @ISOVOLUME_TS@ into 15 more than are written here.
	_vol=$(sed -n 's/^LB_ISO_VOLUME="\(.*\)"/\1/p' config/binary |
		sed 's/@ISOVOLUME_TS@/20260101-00:00/')
	if [ "${#_vol}" -le 32 ]; then
		ok "branding '$CBPP_BRANDING', volume '$_vol' (${#_vol} chars)"
	else
		fail "ISO volume expands to ${#_vol} chars, over the 32 limit: $_vol"
	fi
fi

# -- suite consistency ------------------------------------------------------

for _f in config/archives/cbpp.list.binary config/archives/cbpp.list.chroot; do
	grep -q "$CBPP_DISTRIBUTION" "$_f" ||
		fail "$_f does not mention '$CBPP_DISTRIBUTION'"
done
grep -q "^LB_DEBIAN_INSTALLER_DISTRIBUTION=\"$CBPP_DISTRIBUTION\"" config/binary ||
	fail "config/binary: debian-installer suite does not match $CBPP_DISTRIBUTION"
ok "suite '$CBPP_DISTRIBUTION' consistent across archives and installer"

# -- package list -----------------------------------------------------------

_pkglist=config/package-lists/live.list.chroot
if [ -s "$_pkglist" ]; then
	if grep -q "$(printf '\r')" "$_pkglist"; then
		fail "$_pkglist contains CRLF line endings - apt reads the CR as part of the package name"
	fi
	ok "package list has $(grep -c '[^[:space:]]' "$_pkglist") entries"
else
	fail "$_pkglist is missing or empty"
fi

# -- bootloader templates ---------------------------------------------------
#
# live.cfg.in is a template; live-build substitutes @LINUX@/@INITRD@/@APPEND_*@.
# Losing a placeholder yields a boot entry that points nowhere.

for _tpl in config/bootloaders/*/live.cfg.in; do
	[ -e "$_tpl" ] || continue
	for _ph in @LINUX@ @INITRD@ @APPEND_LIVE@; do
		grep -q -- "$_ph" "$_tpl" || fail "$_tpl: missing placeholder $_ph"
	done
done
ok "bootloader templates keep their placeholders"

# ---------------------------------------------------------------------------

echo
if [ "$FAIL" -eq 0 ]; then
	echo "cbpp-lint: all checks passed"
else
	echo "cbpp-lint: $FAIL check(s) failed" >&2
	exit 1
fi
